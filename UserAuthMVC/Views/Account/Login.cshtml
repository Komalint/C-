@model UserAuthMVC.Models.LoginViewModel

@{
    ViewBag.Title = "User Login";
}

<div class="row justify-content-center align-items-center py-4">
    <div class="col-12 col-md-8 col-lg-5">
        <div class="card shadow-lg border-0 rounded-4">
            <div class="card-header bg-primary text-white text-center py-4 rounded-top-4">
                <div class="mb-2">
                    <i class="bi bi-person-circle display-4"></i>
                </div>
                <h3 class="fw-bold mb-1">Welcome Back</h3>
                <p class="text-white-50 small mb-0">Sign in with your Email or Username</p>
            </div>

            <div class="card-body p-4 p-md-5">
                @using (Html.BeginForm("Login", "Account", new { ReturnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { @class = "needs-validation", role = "form" }))
                {
                    @Html.AntiForgeryToken()

                    @Html.ValidationSummary(true, "", new { @class = "alert alert-danger py-2 small" })

                    <div class="mb-3">
                        @Html.LabelFor(m => m.EmailOrUsername, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-envelope"></i></span>
                            @Html.TextBoxFor(m => m.EmailOrUsername, new { @class = "form-control", placeholder = "Enter email or username", autofocus = "autofocus", id = "txtLoginUser" })
                        </div>
                        @Html.ValidationMessageFor(m => m.EmailOrUsername, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-3">
                        @Html.LabelFor(m => m.Password, new { @class = "form-label fw-semibold" })
                        <div class="input-group">
                            <span class="input-group-text bg-white text-muted"><i class="bi bi-lock"></i></span>
                            @Html.PasswordFor(m => m.Password, new { @class = "form-control", placeholder = "Enter your password", id = "txtLoginPass" })
                            <button class="btn btn-outline-secondary" type="button" id="togglePasswordBtn">
                                <i class="bi bi-eye" id="toggleIcon"></i>
                            </button>
                        </div>
                        @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                    </div>

                    <div class="mb-4 form-check">
                        @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMeCheck" })
                        @Html.LabelFor(m => m.RememberMe, new { @class = "form-check-label text-muted small" })
                    </div>

                    <div class="d-grid mb-3">
                        <button type="submit" class="btn btn-primary btn-lg shadow-sm fw-semibold">
                            <i class="bi bi-box-arrow-in-right me-1"></i> Sign In
                        </button>
                    </div>
                }

                <div class="text-center mt-3">
                    <p class="text-muted small mb-0">
                        Don't have an account yet?
                        <a href="@Url.Action("Register", "Account")" class="fw-bold text-decoration-none">Create Account</a>
                    </p>
                </div>
            </div>

            <div class="card-footer bg-light border-0 py-3 rounded-bottom-4">
                <div class="alert alert-secondary small mb-0 py-2">
                    <div class="fw-bold text-dark mb-1"><i class="bi bi-key-fill text-warning"></i> Demo Test Accounts (Ready to use):</div>
                    <div><strong>Email:</strong> komal@gmail.com | <strong>Pass:</strong> Password@123</div>
                    <div><strong>Email:</strong> rahul@gmail.com | <strong>Pass:</strong> Password@123</div>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @Scripts.Render("~/bundles/jqueryval")
    <script>
        $(document).ready(function () {
            $('#togglePasswordBtn').on('click', function () {
                var passInput = $('#txtLoginPass');
                var icon = $('#toggleIcon');
                if (passInput.attr('type') === 'password') {
                    passInput.attr('type', 'text');
                    icon.removeClass('bi-eye').addClass('bi-eye-slash');
                } else {
                    passInput.attr('type', 'password');
                    icon.removeClass('bi-eye-slash').addClass('bi-eye');
                }
            });
        });
    </script>
}
