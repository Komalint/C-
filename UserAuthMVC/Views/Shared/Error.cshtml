@model System.Web.Mvc.HandleErrorInfo

@{
    ViewBag.Title = "Error";
}

<div class="row justify-content-center">
    <div class="col-md-8 text-center py-5">
        <h1 class="text-danger display-4"><i class="bi bi-exclamation-octagon"></i> An error occurred</h1>
        <p class="lead text-muted mt-3">An unexpected error occurred while processing your request.</p>
        <a href="@Url.Action("Login", "Account")" class="btn btn-primary mt-3">
            <i class="bi bi-arrow-left"></i> Return to Login
        </a>
    </div>
</div>
