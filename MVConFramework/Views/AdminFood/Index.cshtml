@model MVConFramework.ViewModels.AdminFoodDeliveryViewModel
@{
    ViewBag.Title = "Admin Portal - City Analytics, 7% Fee & Food Safety Verification";
}

<div class="py-4">

    <!-- Top Admin Header -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white">
        <div class="row align-items-center">
            <div class="col-md-7">
                <span class="badge bg-primary rounded-pill px-3 py-1 mb-2">
                    <i class="fa-solid fa-user-shield me-1"></i> FoodExpress System Administrator
                </span>
                <h3 class="fw-extrabold text-dark mb-1">
                    City Sales Analytics & Food Safety Compliance
                </h3>
                <p class="text-muted small mb-0">
                    City-wise sales monitoring, 7% platform revenue reconciliation, food safety & hygiene audits, and multi-database health.
                </p>
            </div>

            <!-- State and City Filters -->
            <div class="col-md-5 text-md-end mt-3 mt-md-0">
                @using (Html.BeginForm("Index", "AdminFood", FormMethod.Get, new { @class = "d-inline-flex flex-wrap align-items-center justify-content-md-end gap-2" }))
                {
                    <label class="small text-muted text-nowrap">Filter State:</label>
                    <select name="state" class="form-select form-select-sm rounded-pill border shadow-sm px-3 fw-bold" onchange="this.form.submit()">
                        @foreach (var st in Model.AvailableStates)
                        {
                            <option value="@st" @(string.Equals(Model.SelectedState, st, StringComparison.OrdinalIgnoreCase) || (string.IsNullOrEmpty(Model.SelectedState) && st == "All States") ? "selected" : "")>
                                @(st == "All States" ? "🌍 All States" : (st == "Delhi" ? "🏛️ Delhi" : (st == "Gujarat" ? "🌾 Gujarat" : (st == "Maharashtra" ? "🌊 Maharashtra" : (st == "Rajasthan" ? "🏰 Rajasthan" : "🕌 Uttar Pradesh")))))
                            </option>
                        }
                    </select>

                    <label class="small text-muted text-nowrap">City:</label>
                    <select name="city" class="form-select form-select-sm rounded-pill border shadow-sm px-3" onchange="this.form.submit()">
                        <option value="">All Cities</option>
                        <option value="Delhi" @(Model.SelectedCity == "Delhi" ? "selected" : "")>Delhi</option>
                        <option value="Ahmedabad" @(Model.SelectedCity == "Ahmedabad" ? "selected" : "")>Ahmedabad</option>
                        <option value="Surat" @(Model.SelectedCity == "Surat" ? "selected" : "")>Surat</option>
                        <option value="Mumbai" @(Model.SelectedCity == "Mumbai" ? "selected" : "")>Mumbai</option>
                        <option value="Pune" @(Model.SelectedCity == "Pune" ? "selected" : "")>Pune</option>
                        <option value="Jaipur" @(Model.SelectedCity == "Jaipur" ? "selected" : "")>Jaipur</option>
                        <option value="Lucknow" @(Model.SelectedCity == "Lucknow" ? "selected" : "")>Lucknow</option>
                    </select>
                }
            </div>
        </div>
    </div>

    <!-- Platform KPI Cards (Including 7% Fee) -->
    <div class="row g-3 mb-4">

        <!-- Card 1: Gross Sales -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Gross Food Sales</span>
                    <span class="p-2 bg-success bg-opacity-10 text-success rounded-3"><i class="fa-solid fa-indian-rupee-sign"></i></span>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">&#8377;@Model.TotalGrossSales.ToString("N0")</h3>
                <small class="text-muted">Total sales across all city restaurants</small>
            </div>
        </div>

        <!-- Card 2: 7% Admin Platform Fee Revenue -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100" style="border-left: 4px solid #ff4757 !important;">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Platform Fee (7%)</span>
                    <span class="p-2 bg-danger bg-opacity-10 text-danger rounded-3" style="color: #ff4757 !important;"><i class="fa-solid fa-percent"></i></span>
                </div>
                <h3 class="fw-extrabold text-danger mb-1" style="color: #ff4757 !important;">&#8377;@Model.TotalPlatformFeeRevenue.ToString("N2")</h3>
                <small class="text-muted">7% monthly commission earned by Admin</small>
            </div>
        </div>

        <!-- Card 3: Food Safety Status -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Food Safety Audits</span>
                    <span class="p-2 bg-info bg-opacity-10 text-info rounded-3"><i class="fa-solid fa-shield-halved"></i></span>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">@Model.VerifiedRestaurants <span class="fs-6 fw-normal text-muted">verified</span></h3>
                <div class="small">
                    @if (Model.PendingVerificationsCount > 0)
                    {
                        <span class="badge bg-warning text-dark"><i class="fa-solid fa-clock me-1"></i> @Model.PendingVerificationsCount Pending Review</span>
                    }
                    else
                    {
                        <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i> 100% Up to Date</span>
                    }
                </div>
            </div>
        </div>

        <!-- Card 4: Active Delivery Fleet -->
        <div class="col-sm-6 col-xl-3">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white h-100">
                <div class="d-flex justify-content-between align-items-start mb-2">
                    <span class="text-muted small fw-semibold text-uppercase">Delivery Fleet</span>
                    <span class="p-2 bg-primary bg-opacity-10 text-primary rounded-3"><i class="fa-solid fa-motorcycle"></i></span>
                </div>
                <h3 class="fw-extrabold text-dark mb-1">@Model.ActiveDeliveryAgentsCount <span class="fs-6 fw-normal text-muted">Active Riders</span></h3>
                <small class="text-success fw-medium"><i class="fa-solid fa-circle-check"></i> 10 Riders Aadhaar Verified & Online</small>
            </div>
        </div>

    </div>

    <!-- Dual Database Connectivity Card (Addresses User Request: "one database is missing make that change ui") -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <h5 class="fw-bold mb-0 d-flex align-items-center gap-2">
                <i class="fa-solid fa-database text-warning"></i>
                <span>Database Connectivity & Health (AssignmentDB & Practice)</span>
            </h5>
            <span class="badge bg-success rounded-pill px-3 py-1">2/2 Databases Active</span>
        </div>

        <div class="row g-3">
            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark"><i class="fa-solid fa-server text-primary me-2"></i>AssignmentDB (Food Delivery Engine)</strong>
                        <span class="badge bg-success">@Model.DbHealth.AssignmentDbStatus</span>
                    </div>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> Listed Restaurants: <strong>@Model.DbHealth.AssignmentDbStoresCount</strong></li>
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> Customer Orders: <strong>@Model.DbHealth.AssignmentDbOrdersCount</strong></li>
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> Active Delivery Agents: <strong>@Model.DbHealth.AssignmentDbAgentsCount</strong></li>
                    </ul>
                </div>
            </div>

            <div class="col-md-6">
                <div class="p-3 bg-light rounded-3 border">
                    <div class="d-flex justify-content-between align-items-center mb-1">
                        <strong class="text-dark"><i class="fa-solid fa-graduation-cap text-success me-2"></i>Practice DB (Restored LMS Demo Database)</strong>
                        <span class="badge bg-success">@Model.DbHealth.PracticeDbStatus</span>
                    </div>
                    <ul class="list-unstyled small text-muted mb-0">
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> LMS Users Seeded: <strong>@Model.DbHealth.PracticeDbUsersCount</strong></li>
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> LMS Courses & Payments: <strong>@Model.DbHealth.PracticeDbCoursesCount</strong></li>
                        <li><i class="fa-solid fa-angle-right text-success me-1"></i> Stored Procedures: All 10 LMS procedures restored & operational</li>
                    </ul>
                </div>
            </div>
        </div>
    </div>

    <!-- Pending Food Safety & Hygiene Verification Section -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white" style="border-left: 4px solid #f59e0b !important;">
        <div class="d-flex justify-content-between align-items-center mb-3">
            <div>
                <h5 class="fw-bold mb-1 text-dark">
                    <i class="fa-solid fa-shield-halved text-warning me-2"></i> Food Safety & Hygiene Grounds Verification
                </h5>
                <p class="text-muted small mb-0">
                    Mandatory enrollment verification: Each kitchen in each city must be inspected on FSSAI license, cleanliness audit score, water potability, and pest control compliance.
                </p>
            </div>
            <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                @Model.PendingKitchens.Count Awaiting Audit
            </span>
        </div>

        @if (Model.PendingKitchens != null && Model.PendingKitchens.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th>Kitchen / Restaurant</th>
                            <th>City & Location</th>
                            <th>Applicant / Owner</th>
                            <th>FSSAI License Info</th>
                            <th>Hygiene Audit Factors</th>
                            <th class="text-end">Verification Action</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var k in Model.PendingKitchens)
                        {
                            <tr>
                                <td>
                                    <strong class="text-dark d-block">@k.StoreName</strong>
                                    <span class="text-muted small">@k.Cuisine</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">📍 @k.City, @k.State</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@k.OwnerName</span>
                                    <small class="text-muted">@k.ContactNumber</small>
                                </td>
                                <td>
                                    <code class="text-dark fw-bold">@(string.IsNullOrEmpty(k.FssaiLicenseNo) ? "FSSAI-PEND-2026-9981" : k.FssaiLicenseNo)</code>
                                </td>
                                <td>
                                    <div class="small">
                                        <div class="text-danger fw-semibold"><i class="fa-solid fa-circle-exclamation me-1"></i> Cleanliness Score: @k.HygieneScore/100</div>
                                        <div class="text-muted" style="font-size: 0.72rem;">Pending: Water Quality & Pest Control NOC</div>
                                    </div>
                                </td>
                                <td class="text-end">
                                    <button type="button" class="btn btn-warning btn-sm rounded-pill px-3 fw-bold text-dark shadow-sm" data-bs-toggle="modal" data-bs-target="#verifyModal_@k.StoreId">
                                        <i class="fa-solid fa-clipboard-check me-1"></i> Conduct Audit
                                    </button>
                                </td>
                            </tr>

                            <!-- Food Safety Verification Audit Modal -->
                            <div class="modal fade" id="verifyModal_@k.StoreId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <div class="modal-header bg-dark text-white rounded-top-4 pb-3">
                                            <h5 class="modal-title fw-bold d-flex align-items-center gap-2">
                                                <i class="fa-solid fa-shield-halved text-warning"></i> Food Safety Audit: @k.StoreName
                                            </h5>
                                            <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>

                                        @using (Html.BeginForm("VerifyFoodSafety", "AdminFood", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="storeId" value="@k.StoreId" />

                                            <div class="modal-body p-4">
                                                <div class="alert alert-light border small mb-3">
                                                    <strong>Audit Standards:</strong> To approve, the restaurant must have a verified FSSAI License, a cleanliness score ≥ 80, and certified water & pest control inspections.
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">1. FSSAI License Number</label>
                                                    <input type="text" name="fssaiLicense" value="@(string.IsNullOrEmpty(k.FssaiLicenseNo) ? "FSSAI-10022021000" + k.StoreId : k.FssaiLicenseNo)" class="form-control rounded-3" required />
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">2. Kitchen Cleanliness & Sanitation Audit Score (0 - 100)</label>
                                                    <input type="number" min="0" max="100" name="hygieneScore" value="94" class="form-control rounded-3" required />
                                                    <small class="text-muted">Benchmark: 80+ required for customer order activation.</small>
                                                </div>

                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">3. Water Potability Cert No</label>
                                                        <input type="text" name="waterCert" value="WTR-LAB-2026-@k.StoreId" class="form-control rounded-3" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">4. Pest Control Cert No</label>
                                                        <input type="text" name="pestCert" value="PEST-AUDIT-2026-@k.StoreId" class="form-control rounded-3" />
                                                    </div>
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">5. Fire & Kitchen Safety NOC</label>
                                                    <input type="text" name="fireNoc" value="FIRE-NOC-DL-@k.StoreId" class="form-control rounded-3" />
                                                </div>

                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Auditor Observations / Remarks</label>
                                                    <textarea name="remarks" class="form-control rounded-3" rows="2" placeholder="Cold storage verified, separate raw & cooked stations verified, hygiene compliant.">Kitchen inspected. Separate veg and non-veg refrigeration verified. Complies with food safety guidelines.</textarea>
                                                </div>

                                                <div class="mb-2">
                                                    <label class="form-label small fw-semibold">Audit Determination</label>
                                                    <select name="action" class="form-select rounded-3">
                                                        <option value="Approve" selected>Approve (Issue Food Safety Certification & Go Live)</option>
                                                        <option value="Reject">Reject (Hold enrollment until re-inspection)</option>
                                                    </select>
                                                </div>
                                            </div>

                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-success rounded-pill btn-sm fw-bold px-4">Save Verification Audit</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-4 text-muted small">
                <i class="fa-solid fa-check-double text-success fs-4 d-block mb-1"></i>
                All enrolled restaurants across all cities have completed their food safety verification audit.
            </div>
        }
    </div>

    <!-- City-Wise Financial & Sales Breakdown Table -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white mb-4">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">City-Wise Sales & 7% Platform Fee Register</h5>
            <span class="badge bg-light text-dark border px-3 py-1">@Model.CityMetrics.Count Cities Monitored</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">City</th>
                        <th>Restaurants Listed</th>
                        <th>Verified Ratio</th>
                        <th>Orders Volume</th>
                        <th>Gross Food Sales</th>
                        <th>Admin Platform Fee (7%)</th>
                        <th>Avg Rating</th>
                        <th class="text-end pe-4">Hygiene Index</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var c in Model.CityMetrics)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong class="text-dark fs-6">📍 @c.City</strong>
                                @if (!string.IsNullOrEmpty(c.State))
                                {
                                    <span class="badge bg-light text-muted border ms-1">@c.State</span>
                                }
                            </td>
                            <td>
                                <span class="badge bg-light text-dark border">@c.RestaurantCount Kitchens</span>
                            </td>
                            <td>
                                <span class="badge bg-success rounded-pill">@c.VerifiedCount / @c.RestaurantCount Verified</span>
                            </td>
                            <td>
                                <span class="fw-semibold text-dark">@c.OrdersCount orders</span>
                            </td>
                            <td>
                                <strong class="text-dark">&#8377;@c.CityGrossSales.ToString("N0")</strong>
                            </td>
                            <td>
                                <span class="text-danger fw-bold" style="color: #ff4757 !important;">&#8377;@c.CityPlatformFee.ToString("N2")</span>
                            </td>
                            <td>
                                <span class="text-warning small"><i class="fa-solid fa-star"></i> @c.AvgCityRating.ToString("0.0")</span>
                            </td>
                            <td class="text-end pe-4">
                                <span class="badge bg-light text-success border fw-bold">@c.AvgHygieneScore / 100</span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

    <!-- All Restaurants Roster Table -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">All Enrolled Restaurants Directory</h5>
            <span class="badge bg-light text-dark border px-3 py-1">@Model.AllRestaurants.Count Kitchens</span>
        </div>

        <div class="table-responsive">
            <table class="table table-hover align-middle mb-0">
                <thead class="table-light">
                    <tr class="small text-muted text-uppercase">
                        <th class="ps-4">Restaurant & Cuisine</th>
                        <th>City</th>
                        <th>Owner & Contact</th>
                        <th>Rating & Orders</th>
                        <th>Food Safety & FSSAI</th>
                        <th>Platform Fee (7%)</th>
                        <th class="text-end pe-4">Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var r in Model.AllRestaurants)
                    {
                        <tr>
                            <td class="ps-4">
                                <strong class="text-dark d-block">@r.StoreName</strong>
                                <span class="text-muted small">@r.Cuisine</span>
                            </td>
                            <td>
                                <span class="badge bg-light text-secondary border">📍 @r.City, @r.State</span>
                            </td>
                            <td>
                                <span class="text-dark small d-block">@r.OwnerName</span>
                                <small class="text-muted">@r.ContactNumber</small>
                            </td>
                            <td>
                                <div class="text-warning small fw-bold">
                                    <i class="fa-solid fa-star"></i> @r.Rating.ToString("0.0")
                                </div>
                                <small class="text-muted">@r.TotalOrdersCompleted+ completed</small>
                            </td>
                            <td>
                                <div class="small">
                                    <span class="text-success fw-semibold"><i class="fa-solid fa-shield-halved me-1"></i> Hygiene: @r.HygieneScore/100</span>
                                    <span class="text-muted d-block" style="font-size: 0.72rem;">@r.FssaiLicenseNo</span>
                                </div>
                            </td>
                            <td>
                                <span class="text-danger fw-semibold" style="color: #ff4757 !important;">
                                    &#8377;@Math.Round(r.TotalOrdersCompleted * 350 * 0.07m, 2).ToString("N0")
                                </span>
                            </td>
                            <td class="text-end pe-4">
                                @if (r.IsVerified && r.VerificationStatus == "Approved")
                                {
                                    <span class="badge bg-success rounded-pill px-3 py-1">
                                        <i class="fa-solid fa-circle-check me-1"></i> Approved
                                    </span>
                                }
                                else
                                {
                                    <span class="badge bg-warning text-dark rounded-pill px-3 py-1">
                                        <i class="fa-solid fa-clock me-1"></i> Pending Audit
                                    </span>
                                }
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    </div>

</div>
