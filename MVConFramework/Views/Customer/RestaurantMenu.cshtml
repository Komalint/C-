@model MVConFramework.ViewModels.RestaurantMenuViewModel
@{
    ViewBag.Title = Model.Store.StoreName + " - Digital Menu & Orders";
}

<!-- Restaurant Header Banner -->
<div class="card border-0 rounded-4 shadow-sm mb-4 overflow-hidden">
    <div class="position-relative" style="height: 220px; background: linear-gradient(180deg, rgba(0,0,0,0.1), rgba(0,0,0,0.8)), url('@(string.IsNullOrEmpty(Model.Store.ImageUrl) ? "https://images.unsplash.com/photo-1517248135467-4c7edcad34c4?w=1200" : Model.Store.ImageUrl)') center/cover;">
        <div class="position-absolute bottom-0 start-0 p-4 text-white">
            <div class="d-flex align-items-center gap-2 mb-1">
                <span class="badge bg-danger rounded-pill">📍 @Model.Store.City</span>
                <span class="badge bg-dark bg-opacity-75 rounded-pill"><i class="fa-solid fa-utensils me-1"></i> @Model.Store.Cuisine</span>
                
                @if (Model.Store.TotalOrdersCompleted >= 200 && Model.Store.Rating >= 3.5m)
                {
                    <a href="@Url.Action("Certificate", "Restaurant", new { storeId = Model.Store.StoreId })" class="badge bg-warning text-dark text-decoration-none rounded-pill fw-bold shadow-sm">
                        <i class="fa-solid fa-award me-1"></i> Certified Trusted (200+ Orders)
                    </a>
                }
            </div>
            <h2 class="display-6 fw-extrabold mb-1">@Model.Store.StoreName</h2>
            <p class="mb-0 small" style="opacity: 0.9;">
                <i class="fa-solid fa-location-dot me-1"></i> @Model.Store.Address | 
                <i class="fa-solid fa-phone me-1"></i> @Model.Store.ContactNumber |
                <i class="fa-solid fa-shield-halved text-success me-1"></i> FSSAI: @Model.Store.FssaiLicenseNo (Hygiene: @Model.Store.HygieneScore/100)
            </p>
        </div>

        <div class="position-absolute bottom-0 end-0 p-4 d-none d-md-block text-end">
            <div class="badge bg-white text-dark p-3 rounded-4 shadow-sm text-center">
                <div class="d-flex align-items-center gap-1 text-warning fs-5 fw-bold justify-content-center">
                    <i class="fa-solid fa-star"></i> @Model.Store.Rating.ToString("0.0")
                </div>
                <div class="small text-muted">@Model.Reviews.Count Customer Reviews</div>
            </div>
        </div>
    </div>
</div>

@if (Model.IsInterStateRestricted)
{
    <div class="alert alert-danger border-2 border-danger shadow-sm rounded-4 p-4 mb-4 d-flex align-items-start gap-3" style="background-color: #fff5f5;">
        <i class="fa-solid fa-triangle-exclamation fs-1 text-danger mt-1"></i>
        <div>
            <h5 class="fw-bold text-danger mb-1"><i class="fa-solid fa-ban me-1"></i> Inter-State Food Ordering Restricted</h5>
            <p class="mb-2 text-dark">
                You are currently located in <strong>@Model.CustomerState</strong>, but <strong>@Model.Store.StoreName</strong> is registered in <strong>@Model.Store.State</strong>. Under state food licensing laws, restaurants in @Model.Store.State can only deliver to customer addresses within <strong>@Model.Store.State</strong>.
            </p>
            <div class="d-flex flex-wrap gap-2 mt-2">
                <a href="@Url.Action("Index", "Customer", new { state = Model.Store.State })" class="btn btn-sm btn-danger rounded-pill fw-bold" style="background-color: #ff4757; border-color: #ff4757;">
                    <i class="fa-solid fa-location-dot me-1"></i> Switch My Delivery State to @Model.Store.State
                </a>
                <a href="@Url.Action("Index", "Customer", new { state = Model.CustomerState })" class="btn btn-sm btn-outline-secondary rounded-pill fw-bold bg-white">
                    <i class="fa-solid fa-arrow-left me-1"></i> View Restaurants in @Model.CustomerState
                </a>
            </div>
        </div>
    </div>
}

<div class="row g-4">

    <!-- Menu Items Column (Left, 8 Cols) -->
    <div class="col-lg-8">

        <!-- Category Nav -->
        @if (Model.Categories != null && Model.Categories.Count > 0)
        {
            <div class="d-flex align-items-center gap-2 overflow-auto pb-2 mb-4 border-bottom">
                <button class="btn btn-sm btn-dark rounded-pill px-3 active filter-cat" data-cat="all">All Items</button>
                @foreach (var cat in Model.Categories)
                {
                    <button class="btn btn-sm btn-outline-secondary rounded-pill px-3 filter-cat" data-cat="@cat">@cat</button>
                }
            </div>
        }

        <!-- Dishes List -->
        <div class="row row-cols-1 row-cols-md-2 g-3" id="dishesGrid">
            @if (Model.MenuItems != null && Model.MenuItems.Count > 0)
            {
                foreach (var item in Model.MenuItems)
                {
                    <div class="col dish-card-item" data-cat="@item.Category">
                        <div class="card h-100 border rounded-4 shadow-sm p-3 d-flex flex-column justify-content-between">
                            <div>
                                <div class="d-flex justify-content-between align-items-start mb-2">
                                    <div class="d-flex align-items-center gap-2">
                                        @if (item.IsVeg)
                                        {
                                            <span class="badge border border-success text-success bg-white px-2 py-1" style="font-size: 0.65rem;">
                                                <i class="fa-solid fa-circle text-success me-1"></i> VEG
                                            </span>
                                        }
                                        else
                                        {
                                            <span class="badge border border-danger text-danger bg-white px-2 py-1" style="font-size: 0.65rem;">
                                                <i class="fa-solid fa-play text-danger me-1"></i> NON-VEG
                                            </span>
                                        }
                                        <span class="badge bg-light text-secondary rounded-pill small">@item.Category</span>
                                    </div>
                                    <span class="badge bg-light text-muted small"><i class="fa-regular fa-clock me-1"></i> @item.PrepTimeMinutes min</span>
                                </div>

                                <h6 class="fw-bold text-dark mb-1">@item.ItemName</h6>
                                <p class="text-muted small mb-3 text-truncate-2" style="font-size: 0.82rem; min-height: 38px;">
                                    @(string.IsNullOrEmpty(item.Description) ? "Chef's signature authentic specialty freshly prepared." : item.Description)
                                </p>
                            </div>

                            <div class="d-flex justify-content-between align-items-center pt-2 border-top">
                                <div>
                                    <span class="fs-5 fw-bold text-dark">&#8377;@item.Price.ToString("0")</span>
                                </div>

                                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3 fw-bold add-to-cart-btn"
                                        data-id="@item.MenuItemId" 
                                        data-name="@item.ItemName" 
                                        data-price="@item.Price" 
                                        data-veg="@(item.IsVeg ? "true" : "false")">
                                    <i class="fa-solid fa-plus me-1"></i> ADD
                                </button>
                            </div>
                        </div>
                    </div>
                }
            }
            else
            {
                <div class="col-12 text-center py-5">
                    <p class="text-muted">No dishes listed yet for this restaurant.</p>
                </div>
            }
        </div>

        <!-- Customer Reviews & Evaluation Section -->
        <div class="card border-0 rounded-4 shadow-sm p-4 mt-5">
            <div class="d-flex justify-content-between align-items-center mb-4 border-bottom pb-3">
                <div>
                    <h5 class="fw-bold mb-1"><i class="fa-solid fa-comments text-danger me-2"></i> Customer Reviews & Evaluation</h5>
                    <p class="text-muted small mb-0">Verified customer feedback and kitchen responses</p>
                </div>
                <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#reviewModal">
                    <i class="fa-solid fa-pen me-1"></i> Write a Review
                </button>
            </div>

            @if (Model.Reviews != null && Model.Reviews.Count > 0)
            {
                <div class="list-group list-group-flush">
                    @foreach (var rev in Model.Reviews)
                    {
                        <div class="list-group-item px-0 py-3">
                            <div class="d-flex justify-content-between align-items-center mb-1">
                                <div class="fw-bold text-dark">
                                    <i class="fa-solid fa-user-circle text-secondary me-1"></i> @rev.CustomerName
                                </div>
                                <div class="text-warning small">
                                    @for (int i = 1; i <= 5; i++)
                                    {
                                        if (i <= rev.Rating)
                                        {
                                            <i class="fa-solid fa-star"></i>
                                        }
                                        else
                                        {
                                            <i class="fa-regular fa-star text-muted"></i>
                                        }
                                    }
                                    <span class="text-muted ms-1 small">(@rev.ReviewDate.ToString("dd MMM yyyy"))</span>
                                </div>
                            </div>
                            <p class="text-secondary small mb-2">@rev.Comment</p>

                            @if (!string.IsNullOrEmpty(rev.StoreResponse))
                            {
                                <div class="bg-light p-2 rounded-3 small border-start border-danger border-3 ms-3">
                                    <strong class="text-danger d-block small"><i class="fa-solid fa-reply me-1"></i> Restaurant Kitchen Response:</strong>
                                    <span class="text-muted">@rev.StoreResponse</span>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
            else
            {
                <div class="text-center py-4 text-muted small">
                    No reviews yet. Be the first to place an order and review this kitchen!
                </div>
            }
        </div>

    </div>

    <!-- Live Cart Drawer Column (Right, 4 Cols) -->
    <div class="col-lg-4">
        <div class="card border-0 rounded-4 shadow-sm p-4 sticky-top" style="top: 90px;">
            <div class="d-flex justify-content-between align-items-center mb-3 border-bottom pb-2">
                <h5 class="fw-bold mb-0"><i class="fa-solid fa-bag-shopping text-danger me-2"></i> Your Cart</h5>
                <span class="badge bg-danger rounded-pill" id="cartBadgeCount">0 items</span>
            </div>

            <!-- Cart Items Container -->
            <div id="cartItemsList" class="mb-3" style="max-height: 280px; overflow-y: auto;">
                <div class="text-center py-4 text-muted small" id="emptyCartNotice">
                    <i class="fa-solid fa-basket-shopping fs-3 mb-2 d-block text-secondary opacity-50"></i>
                    Your cart is currently empty.<br />Add items from the menu to proceed.
                </div>
            </div>

            <!-- Bill Breakdown -->
            <div id="cartBillingDetails" class="border-top pt-3" style="display: none;">
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>Item Total</span>
                    <span>&#8377;<span id="billItemTotal">0</span></span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-1">
                    <span>GST &amp; Restaurant Taxes (5%)</span>
                    <span>&#8377;<span id="billGst">0</span></span>
                </div>
                <div class="d-flex justify-content-between small text-muted mb-2">
                    <span>Delivery Fee</span>
                    <span id="billDeliveryFee">&#8377;40</span>
                </div>

                <!-- Estimated Preparation Notice -->
                <div class="alert alert-light border p-2 rounded-3 small mb-3">
                    <i class="fa-solid fa-stopwatch text-danger me-1"></i>
                    Allotted Kitchen Packing: <strong id="allottedPrepTime">15 min</strong>
                </div>

                <div class="d-flex justify-content-between fw-bold text-dark fs-5 mb-3 border-top pt-2">
                    <span>To Pay</span>
                    <span class="text-danger">&#8377;<span id="billGrandTotal">0</span></span>
                </div>

                <!-- Checkout Form -->
                @using (Html.BeginForm("Checkout", "Customer", FormMethod.Get, new { id = "checkoutForm" }))
                {
                    <input type="hidden" name="storeId" value="@Model.Store.StoreId" />
                    <input type="hidden" name="cartJson" id="cartJsonInput" value="" />
                    if (Model.IsInterStateRestricted)
                    {
                        <button type="button" class="btn btn-secondary btn-lg w-100 rounded-pill fw-bold shadow-sm" disabled>
                            <i class="fa-solid fa-ban me-1"></i> Inter-State Delivery Blocked
                        </button>
                        <small class="text-danger d-block text-center mt-2 fw-semibold">
                            Cannot order from @Model.Store.State while in @Model.CustomerState.
                        </small>
                    }
                    else if (Session["UserId"] == null)
                    {
                        <a href="@Url.Action("Login", "Account", new { returnUrl = Request.RawUrl, role = "Customer" })" class="btn btn-warning btn-lg w-100 rounded-pill fw-bold shadow-sm text-dark">
                            <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Login to Place Order
                        </a>
                        <small class="text-muted d-block text-center mt-2" style="font-size: 0.78rem;">
                            <i class="fa-solid fa-lock text-danger me-1"></i> Authentication required: Please log in as Customer before checkout.
                        </small>
                    }
                    else
                    {
                        <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold shadow-sm" style="background-color: #ff4757; border-color: #ff4757;">
                            <i class="fa-solid fa-lock me-1"></i> Proceed to Payment
                        </button>
                    }
                }
            </div>
        </div>
    </div>

</div>

<!-- Write Review Modal -->
<div class="modal fade" id="reviewModal" tabindex="-1" aria-labelledby="reviewModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold" id="reviewModalLabel">Review @Model.Store.StoreName</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("SubmitReview", "Customer", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="storeId" value="@Model.Store.StoreId" />
                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Rating</label>
                        <select name="rating" class="form-select rounded-3">
                            <option value="5" selected>⭐⭐⭐⭐⭐ (5 - Exceptional)</option>
                            <option value="4">⭐⭐⭐⭐ (4 - Very Good)</option>
                            <option value="3">⭐⭐⭐ (3 - Average)</option>
                            <option value="2">⭐⭐ (2 - Below Average)</option>
                            <option value="1">⭐ (1 - Unsatisfactory)</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label fw-semibold">Your Feedback / Review Comments</label>
                        <textarea name="comment" class="form-control rounded-3" rows="3" placeholder="How was the taste, packaging, and food hygiene?"></textarea>
                    </div>
                </div>
                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill btn-sm fw-bold px-4" style="background-color: #ff4757;">Submit Review</button>
                </div>
            }
        </div>
    </div>
</div>

@section scripts {
    <script>
        // Cart data state
        let cart = [];

        // Category filter
        $(".filter-cat").click(function () {
            $(".filter-cat").removeClass("btn-dark active").addClass("btn-outline-secondary");
            $(this).removeClass("btn-outline-secondary").addClass("btn-dark active");
            const cat = $(this).data("cat");
            if (cat === "all") {
                $(".dish-card-item").fadeIn(200);
            } else {
                $(".dish-card-item").hide();
                $(`.dish-card-item[data-cat='${cat}']`).fadeIn(200);
            }
        });

        // Add to Cart
        $(".add-to-cart-btn").click(function () {
            const id = $(this).data("id");
            const name = $(this).data("name");
            const price = parseFloat($(this).data("price"));
            const isVeg = $(this).data("veg") === true || $(this).data("veg") === "true";

            const existing = cart.find(x => x.MenuItemId === id);
            if (existing) {
                existing.Quantity++;
            } else {
                cart.push({ MenuItemId: id, ItemName: name, Price: price, Quantity: 1, IsVeg: isVeg });
            }
            renderCart();
        });

        function changeQty(id, delta) {
            const item = cart.find(x => x.MenuItemId === id);
            if (!item) return;
            item.Quantity += delta;
            if (item.Quantity <= 0) {
                cart = cart.filter(x => x.MenuItemId !== id);
            }
            renderCart();
        }

        function renderCart() {
            const list = $("#cartItemsList");
            list.empty();

            if (cart.length === 0) {
                list.html('<div class="text-center py-4 text-muted small"><i class="fa-solid fa-basket-shopping fs-3 mb-2 d-block text-secondary opacity-50"></i>Your cart is currently empty.<br />Add items from the menu to proceed.</div>');
                $("#cartBillingDetails").hide();
                $("#cartBadgeCount").text("0 items");
                return;
            }

            let totalQty = 0;
            let itemTotal = 0;

            cart.forEach(item => {
                totalQty += item.Quantity;
                itemTotal += (item.Price * item.Quantity);

                const itemRow = `
                    <div class="d-flex justify-content-between align-items-center mb-2 pb-2 border-bottom">
                        <div style="max-width: 65%;">
                            <span class="small fw-semibold text-dark text-truncate d-block">${item.ItemName}</span>
                            <span class="small text-muted">&#8377;${item.Price} x ${item.Quantity}</span>
                        </div>
                        <div class="d-flex align-items-center gap-2">
                            <button type="button" class="btn btn-sm btn-light border py-0 px-2 rounded-circle" onclick="changeQty(${item.MenuItemId}, -1)">-</button>
                            <span class="small fw-bold">${item.Quantity}</span>
                            <button type="button" class="btn btn-sm btn-light border py-0 px-2 rounded-circle" onclick="changeQty(${item.MenuItemId}, 1)">+</button>
                        </div>
                    </div>
                `;
                list.append(itemRow);
            });

            // Packing time calculation:
            // <= 2 items -> 15 min
            // 3 to 5 (or 5+) -> 30 min
            // > 10 items -> 60 min (1 hr)
            let prepTime = 15;
            if (totalQty > 10) prepTime = 60;
            else if (totalQty >= 3) prepTime = 30;
            else prepTime = 15;

            const gst = Math.round(itemTotal * 0.05);
            const delivery = itemTotal > 500 ? 0 : 40;
            const grandTotal = itemTotal + gst + delivery;

            $("#billItemTotal").text(itemTotal);
            $("#billGst").text(gst);
            $("#billDeliveryFee").html(delivery === 0 ? "FREE" : "&#8377;" + delivery);
            $("#billGrandTotal").text(grandTotal);
            $("#allottedPrepTime").text(prepTime + " min");
            $("#cartBadgeCount").text(totalQty + " items");

            $("#cartJsonInput").val(JSON.stringify(cart));
            $("#cartBillingDetails").show();
        }
    </script>
}
