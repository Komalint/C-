@model MVConFramework.ViewModels.OrderReceiptViewModel
@{
    ViewBag.Title = "Payment Receipt - " + Model.InvoiceNumber;
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-8">

            <!-- Success Alert Banner -->
            <div class="alert alert-success border-0 shadow-sm rounded-4 p-4 mb-4 d-flex align-items-center justify-content-between">
                <div class="d-flex align-items-center gap-3">
                    <div class="bg-success text-white rounded-circle p-3 d-flex align-items-center justify-content-center" style="width: 50px; height: 50px;">
                        <i class="fa-solid fa-check fs-4"></i>
                    </div>
                    <div>
                        <h5 class="fw-bold mb-0 text-success">Payment Received & Order Placed!</h5>
                        <p class="mb-0 text-muted small">Your official invoice and dynamic receipt have been generated.</p>
                    </div>
                </div>

                <!-- Live Tracking Link -->
                <a href="@Url.Action("TrackOrder", "Customer", new { id = Model.OrderId })" class="btn btn-danger rounded-pill px-4 py-2 fw-bold shadow-sm" style="background-color: #ff4757; border-color: #ff4757;">
                    <i class="fa-solid fa-map-location-dot me-2"></i> Track Order Live (45 Min)
                </a>
            </div>

            <!-- Dynamic Invoice Card -->
            <div class="card border-0 rounded-4 shadow-lg p-5 bg-white position-relative overflow-hidden" id="printableReceipt">

                <!-- Decorative Top Border -->
                <div class="position-absolute top-0 start-0 end-0" style="height: 6px; background: linear-gradient(90deg, #ff4757, #f59e0b);"></div>

                <!-- Invoice Header -->
                <div class="d-flex justify-content-between align-items-start border-bottom pb-4 mb-4">
                    <div>
                        <div class="d-flex align-items-center gap-2 mb-2">
                            <div class="p-2 bg-danger text-white rounded-3" style="background-color: #ff4757 !important;">
                                <i class="fa-solid fa-utensils fs-5"></i>
                            </div>
                            <h3 class="fw-extrabold text-dark mb-0">@Model.StoreName</h3>
                        </div>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-location-dot me-1"></i> @(string.IsNullOrEmpty(Model.StoreAddress) ? "Central Hub, " + Model.DeliveryCity : Model.StoreAddress)</p>
                        <p class="text-muted small mb-0"><i class="fa-solid fa-shield-halved text-success me-1"></i> FSSAI Lic. No: <strong class="text-dark">@Model.FssaiLicenseNo</strong></p>
                    </div>

                    <div class="text-end">
                        <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1 fw-bold mb-2 d-inline-block">
                            <i class="fa-solid fa-circle-check me-1"></i> PAID VIA @Model.PaymentMethod.ToUpper()
                        </span>
                        <h5 class="fw-bold text-dark mb-0">INVOICE</h5>
                        <div class="text-danger fw-bold small">#@Model.InvoiceNumber</div>
                        <div class="text-muted small">Date: @Model.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</div>
                    </div>
                </div>

                <!-- Bill To & Delivery Details -->
                <div class="row g-3 mb-4 pb-3 border-bottom">
                    <div class="col-md-6">
                        <h6 class="text-secondary small fw-bold text-uppercase mb-2">Billed & Delivered To:</h6>
                        <strong class="text-dark d-block">@Model.CustomerName</strong>
                        <span class="text-muted small d-block">@Model.DeliveryAddress</span>
                        <span class="badge bg-light text-dark border mt-1">📍 @Model.DeliveryCity</span>
                    </div>

                    <div class="col-md-6 text-md-end">
                        <h6 class="text-secondary small fw-bold text-uppercase mb-2">Kitchen Allotment & Logistics:</h6>
                        <div class="small text-muted mb-1">
                            Packing Time Allotted: <strong class="text-danger">@Model.PreparationTimeMinutes minutes</strong>
                        </div>
                        <div class="small text-muted mb-1">
                            Estimated Delivery Time: <strong class="text-dark">@Model.EstimatedDeliveryMinutes minutes (within 45 min)</strong>
                        </div>
                        <div class="small text-muted">
                            Approx Route Distance: <strong class="text-dark">@Model.DistanceKm km</strong>
                        </div>
                    </div>
                </div>

                <!-- Itemized Breakdown Table -->
                <div class="table-responsive mb-4">
                    <table class="table table-borderless">
                        <thead class="table-light rounded-3">
                            <tr class="small text-muted text-uppercase">
                                <th style="width: 50%;">Item Description</th>
                                <th class="text-center" style="width: 15%;">Quantity</th>
                                <th class="text-end" style="width: 35%;">Amount</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr class="border-bottom">
                                <td>
                                    <strong class="text-dark d-block">@Model.ProductName</strong>
                                    <span class="text-muted small">Freshly prepared order from @Model.StoreName</span>
                                </td>
                                <td class="text-center fw-bold">@Model.Quantity</td>
                                <td class="text-end fw-bold">&#8377;@Model.TotalAmount.ToString("0")</td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <!-- Financial Calculation & Platform Fee Note -->
                <div class="row align-items-center mb-4">
                    <div class="col-md-6">
                        <div class="p-3 bg-light rounded-3 small text-muted border">
                            <div class="d-flex align-items-center gap-2 mb-1 text-dark fw-bold">
                                <i class="fa-solid fa-percent text-danger"></i> 7% Platform Fee Transparency
                            </div>
                            <span>Platform technology &amp; food safety fee contribution: &#8377;@Model.PlatformFee.ToString("0.00")</span>
                        </div>
                    </div>

                    <div class="col-md-6">
                        <div class="text-end">
                            <div class="d-flex justify-content-between mb-1 small text-muted">
                                <span>Subtotal:</span>
                                <span>&#8377;@(Model.TotalAmount - Math.Round(Model.TotalAmount * 0.05m))</span>
                            </div>
                            <div class="d-flex justify-content-between mb-2 small text-muted">
                                <span>Taxes &amp; GST:</span>
                                <span>&#8377;@Math.Round(Model.TotalAmount * 0.05m)</span>
                            </div>
                            <div class="d-flex justify-content-between border-top pt-2">
                                <span class="fs-5 fw-bold text-dark">Total Paid:</span>
                                <span class="fs-4 fw-extrabold text-danger">&#8377;@Model.TotalAmount.ToString("0")</span>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Footer Sign-off -->
                <div class="border-top pt-4 text-center text-muted small">
                    <p class="mb-1 fw-semibold text-dark">Thank you for ordering with FoodExpress & @Model.StoreName!</p>
                    <p class="mb-0">This is a system-generated electronic dynamic receipt with verified cryptographic transaction reference.</p>
                </div>

            </div>

            <!-- Action Buttons -->
            <div class="d-flex justify-content-between align-items-center mt-4">
                <button type="button" class="btn btn-outline-dark rounded-pill px-4" onclick="window.print()">
                    <i class="fa-solid fa-print me-2"></i> Print / Save Receipt
                </button>

                <div class="d-flex gap-2">
                    <a href="@Url.Action("MyOrders", "Customer")" class="btn btn-outline-secondary rounded-pill px-4">
                        <i class="fa-solid fa-clock-rotate-left me-1"></i> All Orders
                    </a>
                    <a href="@Url.Action("TrackOrder", "Customer", new { id = Model.OrderId })" class="btn btn-danger rounded-pill px-4 fw-bold" style="background-color: #ff4757; border-color: #ff4757;">
                        <i class="fa-solid fa-location-crosshairs me-2"></i> Track Delivery (45m ETA)
                    </a>
                </div>
            </div>

        </div>
    </div>
</div>
