@model MVConFramework.ViewModels.RestaurantDashboardViewModel
@{
    ViewBag.Title = Model.Store != null ? Model.Store.StoreName + " - Financial Invoices" : "Invoices";
}

<div class="py-4">

    <!-- Top Navigation Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="fa-solid fa-file-invoice-dollar text-danger me-2"></i> Restaurant Sales & Invoices
            </h3>
            <p class="text-muted small mb-0">Financial statement showing all orders, transparent 7% admin platform fee deduction, and net payout transfers.</p>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Restaurant", new { storeId = Model.Store != null ? Model.Store.StoreId : 1 })" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Kitchen
            </a>
            <button type="button" class="btn btn-outline-dark rounded-pill px-4" onclick="window.print()">
                <i class="fa-solid fa-print me-1"></i> Print Statement
            </button>
        </div>
    </div>

    <!-- Financial Reconciliation Card -->
    <div class="row g-3 mb-4">
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white">
                <span class="text-muted small fw-semibold text-uppercase">Total Gross Sales</span>
                <h3 class="fw-extrabold text-dark mb-1">&#8377;@Model.GrossSales.ToString("N2")</h3>
                <small class="text-muted">Total value of customer food orders</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white" style="border-left: 4px solid #f59e0b !important;">
                <span class="text-muted small fw-semibold text-uppercase">7% Platform Fee to Admin</span>
                <h3 class="fw-extrabold text-warning mb-1">&#8377;@Model.PlatformFeeDeducted.ToString("N2")</h3>
                <small class="text-muted">7% monthly platform commission deducted</small>
            </div>
        </div>
        <div class="col-md-4">
            <div class="card border-0 rounded-4 shadow-sm p-4 bg-white" style="border-left: 4px solid #10b981 !important;">
                <span class="text-muted small fw-semibold text-uppercase">Net Restaurant Payout (93%)</span>
                <h3 class="fw-extrabold text-success mb-1">&#8377;@Model.NetPayout.ToString("N2")</h3>
                <small class="text-muted">Direct transfer to merchant bank account</small>
            </div>
        </div>
    </div>

    <!-- Invoices Table Card -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-4 d-flex justify-content-between align-items-center">
            <h5 class="fw-bold mb-0">Itemized Orders & Invoices Register</h5>
            <span class="badge bg-light text-dark border px-3 py-1">@Model.LiveOrders.Count Orders</span>
        </div>

        @if (Model.LiveOrders != null && Model.LiveOrders.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Invoice # & Date</th>
                            <th>Customer & City</th>
                            <th>Items</th>
                            <th>Gross Amount</th>
                            <th>Platform Fee (7%)</th>
                            <th>Net Payout (93%)</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Receipt</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var o in Model.LiveOrders)
                        {
                            decimal gross = o.TotalAmount;
                            decimal fee = o.PlatformFee > 0 ? o.PlatformFee : Math.Round(gross * 0.07m, 2);
                            decimal net = gross - fee;

                            <tr>
                                <td class="ps-4">
                                    <strong class="text-dark d-block">@o.InvoiceNumber</strong>
                                    <span class="text-muted small">@o.OrderDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                                </td>
                                <td>
                                    <span class="fw-semibold text-dark d-block">@o.CustomerName</span>
                                    <span class="text-muted small">📍 @o.DeliveryCity</span>
                                </td>
                                <td>
                                    <span class="small text-dark d-block text-truncate" style="max-width: 180px;" title="@o.ProductName">@o.ProductName</span>
                                    <span class="badge bg-light text-muted border">Qty: @o.Quantity</span>
                                </td>
                                <td>
                                    <strong class="text-dark">&#8377;@gross.ToString("0.00")</strong>
                                </td>
                                <td>
                                    <span class="text-danger fw-semibold">- &#8377;@fee.ToString("0.00")</span>
                                </td>
                                <td>
                                    <strong class="text-success">&#8377;@net.ToString("0.00")</strong>
                                </td>
                                <td>
                                    <span class="badge bg-success rounded-pill">@o.OrderStatus</span>
                                </td>
                                <td class="text-end pe-4">
                                    <a href="@Url.Action("Receipt", "Customer", new { id = o.OrderId })" target="_blank" class="btn btn-outline-secondary btn-sm rounded-pill px-3">
                                        <i class="fa-solid fa-file-invoice me-1"></i> View Receipt
                                    </a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted small">
                No invoices recorded for this store yet.
            </div>
        }
    </div>

</div>
