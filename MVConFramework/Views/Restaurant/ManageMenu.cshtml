@model List<MVConFramework.Models.MenuItem>
@{
    var store = (MVConFramework.Models.Stores)ViewBag.Store;
    ViewBag.Title = (store != null ? store.StoreName : "Restaurant") + " - Digital Menu Management";
}

<div class="py-4">

    <!-- Top Navigation Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="fa-solid fa-book-open text-danger me-2"></i> Menu Management (CRUD)
            </h3>
            <p class="text-muted small mb-0">Create, edit, update, and manage pricing, categories, and prep times for @(store != null ? store.StoreName : "your store").</p>
        </div>

        <div class="d-flex gap-2">
            <a href="@Url.Action("Index", "Restaurant", new { storeId = store != null ? store.StoreId : 1 })" class="btn btn-outline-secondary rounded-pill px-4">
                <i class="fa-solid fa-arrow-left me-1"></i> Back to Kitchen
            </a>
            <button type="button" class="btn btn-danger rounded-pill px-4 fw-bold shadow-sm" style="background-color: #ff4757; border-color: #ff4757;" data-bs-toggle="modal" data-bs-target="#addDishModal">
                <i class="fa-solid fa-plus me-1"></i> Add New Dish
            </button>
        </div>
    </div>

    <!-- Menu Table Card -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        @if (Model != null && Model.Count > 0)
        {
            <div class="table-responsive">
                <table class="table table-hover align-middle mb-0">
                    <thead class="table-light">
                        <tr class="small text-muted text-uppercase">
                            <th class="ps-4">Dish Name & Image</th>
                            <th>Category</th>
                            <th>Type</th>
                            <th>Price</th>
                            <th>Prep Time</th>
                            <th>Status</th>
                            <th class="text-end pe-4">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var item in Model)
                        {
                            <tr>
                                <td class="ps-4">
                                    <div class="d-flex align-items-center gap-3">
                                        <img src="@(string.IsNullOrEmpty(item.ImageUrl) ? "https://images.unsplash.com/photo-1546069901-ba9599a7e63c?w=100" : item.ImageUrl)" 
                                             class="rounded-3 shadow-sm" style="width: 48px; height: 48px; object-fit: cover;" alt="@item.ItemName" />
                                        <div>
                                            <strong class="text-dark d-block">@item.ItemName</strong>
                                            <small class="text-muted text-truncate d-block" style="max-width: 250px;">@item.Description</small>
                                        </div>
                                    </div>
                                </td>
                                <td>
                                    <span class="badge bg-light text-secondary border">@item.Category</span>
                                </td>
                                <td>
                                    @if (item.IsVeg)
                                    {
                                        <span class="badge border border-success text-success bg-white px-2 py-1 small">
                                            <i class="fa-solid fa-circle text-success me-1"></i> VEG
                                        </span>
                                    }
                                    else
                                    {
                                        <span class="badge border border-danger text-danger bg-white px-2 py-1 small">
                                            <i class="fa-solid fa-play text-danger me-1"></i> NON-VEG
                                        </span>
                                    }
                                </td>
                                <td>
                                    <span class="fs-6 fw-bold text-dark">&#8377;@item.Price.ToString("0")</span>
                                </td>
                                <td>
                                    <span class="badge bg-light text-dark border">
                                        <i class="fa-regular fa-clock me-1"></i> @item.PrepTimeMinutes min
                                    </span>
                                </td>
                                <td>
                                    @if (item.IsAvailable)
                                    {
                                        <span class="badge bg-success rounded-pill">Available</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary rounded-pill">Disabled</span>
                                    }
                                </td>
                                <td class="text-end pe-4">
                                    <div class="d-flex justify-content-end gap-2">
                                        <!-- Edit Button -->
                                        <button type="button" class="btn btn-outline-primary btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#editDishModal_@item.MenuItemId">
                                            <i class="fa-solid fa-pen-to-square me-1"></i> Edit
                                        </button>

                                        <!-- Delete Button -->
                                        @using (Html.BeginForm("DeleteMenuItem", "Restaurant", FormMethod.Post, new { onsubmit = "return confirm('Are you sure you want to delete this dish?');" }))
                                        {
                                            <input type="hidden" name="id" value="@item.MenuItemId" />
                                            <input type="hidden" name="storeId" value="@(store != null ? store.StoreId : item.StoreId)" />
                                            <button type="submit" class="btn btn-outline-danger btn-sm rounded-pill px-2">
                                                <i class="fa-solid fa-trash"></i>
                                            </button>
                                        }
                                    </div>
                                </td>
                            </tr>

                            <!-- Edit Dish Modal for this item -->
                            <div class="modal fade" id="editDishModal_@item.MenuItemId" tabindex="-1" aria-hidden="true">
                                <div class="modal-dialog modal-dialog-centered">
                                    <div class="modal-content rounded-4 border-0 shadow">
                                        <div class="modal-header border-0 pb-0">
                                            <h5 class="modal-title fw-bold">Edit Dish: @item.ItemName</h5>
                                            <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                        </div>
                                        @using (Html.BeginForm("SaveMenuItem", "Restaurant", FormMethod.Post))
                                        {
                                            @Html.AntiForgeryToken()
                                            <input type="hidden" name="MenuItemId" value="@item.MenuItemId" />
                                            <input type="hidden" name="StoreId" value="@(store != null ? store.StoreId : item.StoreId)" />

                                            <div class="modal-body">
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Dish Name</label>
                                                    <input type="text" name="ItemName" value="@item.ItemName" class="form-control rounded-3" required />
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Category</label>
                                                        <select name="Category" class="form-select rounded-3">
                                                            <option value="Starters" @(item.Category == "Starters" ? "selected" : "")>Starters</option>
                                                            <option value="Main Course" @(item.Category == "Main Course" ? "selected" : "")>Main Course</option>
                                                            <option value="Biryani Special" @(item.Category == "Biryani Special" ? "selected" : "")>Biryani Special</option>
                                                            <option value="Breads" @(item.Category == "Breads" ? "selected" : "")>Breads</option>
                                                            <option value="Desserts" @(item.Category == "Desserts" ? "selected" : "")>Desserts</option>
                                                            <option value="Beverages" @(item.Category == "Beverages" ? "selected" : "")>Beverages</option>
                                                        </select>
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Price (&#8377;)</label>
                                                        <input type="number" step="1" name="Price" value="@item.Price" class="form-control rounded-3" required />
                                                    </div>
                                                </div>
                                                <div class="row g-2 mb-3">
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Prep Time (Min)</label>
                                                        <input type="number" name="PrepTimeMinutes" value="@item.PrepTimeMinutes" class="form-control rounded-3" />
                                                    </div>
                                                    <div class="col-6">
                                                        <label class="form-label small fw-semibold">Food Type</label>
                                                        <select name="IsVeg" class="form-select rounded-3">
                                                            <option value="true" @(item.IsVeg ? "selected" : "")>Veg</option>
                                                            <option value="false" @(!item.IsVeg ? "selected" : "")>Non-Veg</option>
                                                        </select>
                                                    </div>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Description</label>
                                                    <textarea name="Description" class="form-control rounded-3" rows="2">@item.Description</textarea>
                                                </div>
                                                <div class="mb-3">
                                                    <label class="form-label small fw-semibold">Image URL (Unsplash / Web)</label>
                                                    <input type="url" name="ImageUrl" value="@item.ImageUrl" class="form-control rounded-3" />
                                                </div>
                                                <div class="form-check form-switch">
                                                    <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" @(item.IsAvailable ? "checked" : "") id="avail_@item.MenuItemId">
                                                    <label class="form-check-label small fw-semibold" for="avail_@item.MenuItemId">Active & Available for Ordering</label>
                                                </div>
                                            </div>

                                            <div class="modal-footer border-0 pt-0">
                                                <button type="button" class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                                                <button type="submit" class="btn btn-primary rounded-pill btn-sm fw-bold px-4">Update Dish</button>
                                            </div>
                                        }
                                    </div>
                                </div>
                            </div>
                        }
                    </tbody>
                </table>
            </div>
        }
        else
        {
            <div class="text-center py-5">
                <i class="fa-solid fa-utensils display-4 text-muted mb-3"></i>
                <h5 class="fw-bold">No Menu Items Listed</h5>
                <p class="text-muted small">Click the "Add New Dish" button above to create your first menu item.</p>
            </div>
        }
    </div>

</div>

<!-- Add Dish Modal -->
<div class="modal fade" id="addDishModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content rounded-4 border-0 shadow">
            <div class="modal-header border-0 pb-0">
                <h5 class="modal-title fw-bold">Add New Dish to Menu</h5>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            @using (Html.BeginForm("SaveMenuItem", "Restaurant", FormMethod.Post))
            {
                @Html.AntiForgeryToken()
                <input type="hidden" name="MenuItemId" value="0" />
                <input type="hidden" name="StoreId" value="@(store != null ? store.StoreId : 1)" />

                <div class="modal-body">
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Dish Name</label>
                        <input type="text" name="ItemName" class="form-control rounded-3" placeholder="e.g. Paneer Butter Masala" required />
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Category</label>
                            <select name="Category" class="form-select rounded-3">
                                <option value="Starters">Starters</option>
                                <option value="Main Course" selected>Main Course</option>
                                <option value="Biryani Special">Biryani Special</option>
                                <option value="Breads">Breads</option>
                                <option value="Desserts">Desserts</option>
                                <option value="Beverages">Beverages</option>
                            </select>
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Price (&#8377;)</label>
                            <input type="number" step="1" name="Price" class="form-control rounded-3" placeholder="299" required />
                        </div>
                    </div>
                    <div class="row g-2 mb-3">
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Prep Time (Min)</label>
                            <input type="number" name="PrepTimeMinutes" value="15" class="form-control rounded-3" />
                        </div>
                        <div class="col-6">
                            <label class="form-label small fw-semibold">Food Type</label>
                            <select name="IsVeg" class="form-select rounded-3">
                                <option value="true" selected>Veg</option>
                                <option value="false">Non-Veg</option>
                            </select>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Description</label>
                        <textarea name="Description" class="form-control rounded-3" rows="2" placeholder="Fresh spices, authentic recipe details..."></textarea>
                    </div>
                    <div class="mb-3">
                        <label class="form-label small fw-semibold">Image URL (Optional)</label>
                        <input type="url" name="ImageUrl" class="form-control rounded-3" placeholder="https://..." />
                    </div>
                    <div class="form-check form-switch">
                        <input class="form-check-input" type="checkbox" name="IsAvailable" value="true" checked id="newAvailCheck">
                        <label class="form-check-label small fw-semibold" for="newAvailCheck">Immediately Available for Orders</label>
                    </div>
                </div>

                <div class="modal-footer border-0 pt-0">
                    <button type="button" class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                    <button type="submit" class="btn btn-danger rounded-pill btn-sm fw-bold px-4" style="background-color: #ff4757;">Save Dish</button>
                </div>
            }
        </div>
    </div>
</div>
