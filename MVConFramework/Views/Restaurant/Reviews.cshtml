@model List<MVConFramework.Models.Review>
@{
    var store = (MVConFramework.Models.Stores)ViewBag.Store;
    ViewBag.Title = (store != null ? store.StoreName : "Restaurant") + " - Customer Reviews & Evaluation";
}

<div class="py-4">

    <!-- Top Navigation Header -->
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h3 class="fw-extrabold text-dark mb-1">
                <i class="fa-solid fa-comments text-danger me-2"></i> Reviews & Customer Feedback Evaluation
            </h3>
            <p class="text-muted small mb-0">Evaluate customer ratings, inspect feedback on food quality and packaging, and post official kitchen responses.</p>
        </div>

        <a href="@Url.Action("Index", "Restaurant")" class="btn btn-outline-secondary rounded-pill px-4">
            <i class="fa-solid fa-arrow-left me-1"></i> Back to Kitchen
        </a>
    </div>

    <!-- Rating Summary Card -->
    <div class="card border-0 rounded-4 shadow-sm p-4 mb-4 bg-white">
        <div class="row align-items-center">
            <div class="col-md-4 text-center border-end">
                <div class="display-4 fw-extrabold text-warning mb-1">
                    <i class="fa-solid fa-star"></i> @(store != null ? store.Rating.ToString("0.0") : "4.5")
                </div>
                <div class="fw-bold text-dark">Average Customer Rating</div>
                <small class="text-muted">Based on @(Model != null ? Model.Count : 0) verified reviews</small>
            </div>

            <div class="col-md-8 px-md-4 mt-3 mt-md-0">
                <h6 class="fw-bold text-dark mb-2">Quality & Trust Benchmark</h6>
                <p class="text-muted small mb-3">
                    Restaurants maintaining an average rating of 3.5 to 5.0 with 200+ completed orders qualify for the prestigious <strong>Certificate of Food Quality, Hygiene & Customer Trust</strong>.
                </p>
                <div class="d-flex align-items-center gap-3">
                    <span class="badge bg-success bg-opacity-10 text-success border border-success border-opacity-25 rounded-pill px-3 py-1">
                        <i class="fa-solid fa-circle-check me-1"></i> Verified Authentic Reviews
                    </span>
                    <span class="badge bg-warning bg-opacity-10 text-warning border border-warning border-opacity-25 rounded-pill px-3 py-1">
                        <i class="fa-solid fa-award me-1"></i> Trust Threshold: ≥ 3.5★
                    </span>
                </div>
            </div>
        </div>
    </div>

    <!-- Reviews List Card -->
    <div class="card border-0 rounded-4 shadow-sm overflow-hidden bg-white">
        <div class="card-header bg-white border-bottom p-4">
            <h5 class="fw-bold mb-0">Customer Feedback & Evaluation Feed</h5>
        </div>

        @if (Model != null && Model.Count > 0)
        {
            <div class="list-group list-group-flush">
                @foreach (var rev in Model)
                {
                    <div class="list-group-item p-4">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <strong class="text-dark fs-6 d-block">
                                    <i class="fa-solid fa-user-circle text-secondary me-2"></i> @rev.CustomerName
                                </strong>
                                <span class="text-muted small">Reviewed on @rev.ReviewDate.ToString("dd MMM yyyy, hh:mm tt")</span>
                            </div>

                            <div class="text-warning">
                                @for (int i = 1; i <= 5; i++)
                                {
                                    if (i <= rev.Rating)
                                    {
                                        <i class="fa-solid fa-star"></i>
                                    }
                                    else
                                    {
                                        <i class="fa-regular fa-star text-muted"></i>
                                    }
                                }
                                <span class="badge @(rev.Rating >= 4 ? "bg-success" : (rev.Rating == 3 ? "bg-warning text-dark" : "bg-danger")) rounded-pill ms-2">
                                    @(rev.Rating).0★
                                </span>
                            </div>
                        </div>

                        <p class="text-secondary small mb-3 bg-light p-3 rounded-3 border">
                            "@(string.IsNullOrEmpty(rev.Comment) ? "Food arrived fresh and well-packaged. Great taste!" : rev.Comment)"
                        </p>

                        <!-- Existing Response -->
                        @if (!string.IsNullOrEmpty(rev.StoreResponse))
                        {
                            <div class="p-3 rounded-3 bg-light border-start border-danger border-4 ms-3 mb-2">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong class="text-danger small"><i class="fa-solid fa-reply me-1"></i> Restaurant Response:</strong>
                                    <span class="text-muted" style="font-size: 0.72rem;">@(rev.ResponseDate.HasValue ? rev.ResponseDate.Value.ToString("dd MMM yyyy") : "")</span>
                                </div>
                                <span class="text-muted small">@rev.StoreResponse</span>
                            </div>
                        }

                        <!-- Response Action Button -->
                        <div class="text-end">
                            <button type="button" class="btn btn-outline-danger btn-sm rounded-pill px-3" data-bs-toggle="modal" data-bs-target="#respondModal_@rev.ReviewId">
                                <i class="fa-solid fa-reply me-1"></i> @(string.IsNullOrEmpty(rev.StoreResponse) ? "Evaluate & Respond" : "Edit Response")
                            </button>
                        </div>
                    </div>

                    <!-- Respond Modal for this review -->
                    <div class="modal fade" id="respondModal_@rev.ReviewId" tabindex="-1" aria-hidden="true">
                        <div class="modal-dialog modal-dialog-centered">
                            <div class="modal-content rounded-4 border-0 shadow">
                                <div class="modal-header border-0 pb-0">
                                    <h5 class="modal-title fw-bold">Evaluate & Respond to @rev.CustomerName</h5>
                                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                                </div>
                                @using (Html.BeginForm("RespondReview", "Restaurant", FormMethod.Post))
                                {
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="reviewId" value="@rev.ReviewId" />
                                    <input type="hidden" name="storeId" value="@(store != null ? store.StoreId : rev.StoreId)" />

                                    <div class="modal-body">
                                        <div class="mb-3">
                                            <label class="form-label small fw-semibold text-muted">Customer Rating & Feedback:</label>
                                            <div class="p-2 bg-light rounded-3 small">
                                                <strong>@(rev.Rating) ★:</strong> "@rev.Comment"
                                            </div>
                                        </div>
                                        <div class="mb-2">
                                            <label class="form-label small fw-semibold">Kitchen Management Response:</label>
                                            <textarea name="response" class="form-control rounded-3" rows="3" placeholder="Thank the customer or address their feedback regarding taste, packaging, hygiene...">@rev.StoreResponse</textarea>
                                        </div>
                                    </div>
                                    <div class="modal-footer border-0 pt-0">
                                        <button type="button" class="btn btn-light rounded-pill btn-sm" data-bs-dismiss="modal">Cancel</button>
                                        <button type="submit" class="btn btn-danger rounded-pill btn-sm fw-bold px-4" style="background-color: #ff4757;">Post Official Response</button>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                }
            </div>
        }
        else
        {
            <div class="text-center py-5 text-muted small">
                No customer reviews posted yet for this restaurant.
            </div>
        }
    </div>

</div>
