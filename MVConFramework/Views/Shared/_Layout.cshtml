<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - FoodExpress | Online Food Delivery & Restaurant Platform</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    @Styles.Render("~/Content/css")

    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Bootstrap Icons Fallback -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @Scripts.Render("~/bundles/modernizr")

    <style>
        :root {
            --primary-food: #ff4757;
            --primary-hover: #e04050;
            --primary-subtle: #fff1f2;
            --accent-gold: #f59e0b;
            --dark-surface: #0f172a;
            --card-radius: 16px;
        }

        html, body {
            max-width: 100vw;
            overflow-x: hidden;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navbar Styling */
        .navbar-brand-food {
            font-weight: 800;
            font-size: 1.45rem;
            letter-spacing: -0.5px;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .navbar-brand-food .brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #ff6b81, #ff4757);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 12px rgba(255, 71, 87, 0.4);
        }

        .main-nav {
            background: #111827;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .nav-link-custom {
            color: #cbd5e1 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 8px 14px !important;
            border-radius: 10px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-link-custom:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.08);
        }
        .nav-link-custom.active {
            color: #ffffff !important;
            background: #ff4757;
            font-weight: 600;
            box-shadow: 0 2px 10px rgba(255, 71, 87, 0.35);
        }

        /* Database Health Badge */
        .db-health-pill {
            background: rgba(16, 185, 129, 0.12);
            border: 1px solid rgba(16, 185, 129, 0.35);
            color: #10b981;
            padding: 5px 12px;
            border-radius: 30px;
            font-size: 0.78rem;
            font-weight: 600;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }
        .db-health-pill .dot {
            width: 7px;
            height: 7px;
            background-color: #10b981;
            border-radius: 50%;
            display: inline-block;
            box-shadow: 0 0 6px #10b981;
        }

        /* Notification Badge */
        .notification-btn {
            position: relative;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            border-radius: 12px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .notification-btn:hover {
            background: rgba(255,255,255,0.18);
            color: white;
        }
        .notification-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #ff4757;
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            border: 2px solid #111827;
        }

        /* Notifications Dropdown Panel */
        .notification-menu {
            width: 360px;
            max-height: 440px;
            overflow-y: auto;
            border-radius: 14px;
            box-shadow: 0 12px 35px rgba(0,0,0,0.18);
            border: 1px solid #e2e8f0;
            padding: 0;
        }
        .notification-header {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }
        .notification-item {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.15s;
        }
        .notification-item:hover {
            background: #f8fafc;
        }
        .notification-item.unread {
            background: #fff5f5;
        }

        /* Food Card styles */
        .food-card {
            background: white;
            border-radius: var(--card-radius);
            border: 1px solid #e2e8f0;
            transition: transform 0.2s, box-shadow 0.2s;
            overflow: hidden;
        }
        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.06);
        }

        /* Flash Alerts */
        .flash-alert-container {
            margin-top: 15px;
        }

        /* Footer */
        footer {
            margin-top: auto;
            background: #111827;
            color: #94a3b8;
            border-top: 1px solid rgba(255,255,255,0.08);
            font-size: 0.9rem;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>

    <!-- Main Navigation Bar -->
    <nav class="navbar navbar-expand-lg navbar-dark main-nav sticky-top">
        <div class="container-fluid px-2 px-sm-3 px-xl-4">

            <!-- Brand Logo -->
            <a href="@Url.Action("Index", "Customer")" class="navbar-brand navbar-brand-food me-2 me-lg-3 flex-shrink-0">
                <div class="brand-icon">
                    <i class="fa-solid fa-utensils"></i>
                </div>
                <span>Food<span style="color: #ff4757;">Express</span></span>
            </a>

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#foodNavbar" aria-controls="foodNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>

            <!-- Navbar Links -->
            <div class="collapse navbar-collapse" id="foodNavbar">
                <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">

                    <!-- Customer / Explore Food -->
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom @(ViewBag.ActiveTab == "Customer" ? "active" : "")" href="@Url.Action("Index", "Customer")">
                            <i class="fa-solid fa-bowl-food text-warning"></i>
                            <span>Explore Food</span>
                        </a>
                    </li>

                    <!-- Customer Orders -->
                    <li class="nav-item">
                        <a class="nav-link nav-link-custom" href="@Url.Action("MyOrders", "Customer")">
                            <i class="fa-solid fa-receipt text-info"></i>
                            <span>My Orders</span>
                        </a>
                    </li>

                    @{
                        string currentRole = (Session["UserRole"] != null ? Session["UserRole"].ToString() : "").Trim();
                    }

                    @if (currentRole.Equals("Restaurant", StringComparison.OrdinalIgnoreCase))
                    {
                        <!-- Active Restaurant Role Nav -->
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewBag.ActiveTab == "Restaurant" ? "active" : "")" href="@Url.Action("Index", "Restaurant")">
                                <i class="fa-solid fa-kitchen-set text-danger"></i>
                                <span>Kitchen Dashboard</span>
                            </a>
                        </li>
                    }
                    else if (currentRole.Equals("DeliveryAgent", StringComparison.OrdinalIgnoreCase) || currentRole.Equals("Rider", StringComparison.OrdinalIgnoreCase))
                    {
                        <!-- Active Delivery Partner Role Nav -->
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewBag.ActiveTab == "DeliveryAgent" ? "active" : "")" href="@Url.Action("Index", "DeliveryAgent")">
                                <i class="fa-solid fa-motorcycle text-success"></i>
                                <span>Rider Portal</span>
                            </a>
                        </li>
                    }
                    else if (currentRole.Equals("Admin", StringComparison.OrdinalIgnoreCase))
                    {
                        <!-- Active Admin Role Nav -->
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(ViewBag.ActiveTab == "Admin" ? "active" : "")" href="@Url.Action("Index", "AdminFood")">
                                <i class="fa-solid fa-shield-halved text-primary"></i>
                                <span>Admin Portal</span>
                            </a>
                        </li>
                    }

                    <!-- Portals Dropdown for Seamless Access Across Roles & Demos -->
                    <li class="nav-item dropdown">
                        <a class="nav-link nav-link-custom dropdown-toggle text-secondary" href="#" id="portalsDropdown" role="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="fa-solid fa-layer-group"></i>
                            <span>Portals</span>
                        </a>
                        <ul class="dropdown-menu dropdown-menu-dark shadow" aria-labelledby="portalsDropdown">
                            <li class="dropdown-header text-uppercase small text-muted">Role Dashboards</li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer")"><i class="fa-solid fa-bowl-food text-warning me-2"></i>Customer Experience</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Restaurant")"><i class="fa-solid fa-kitchen-set text-danger me-2"></i>Restaurant Partner</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "DeliveryAgent")"><i class="fa-solid fa-motorcycle text-success me-2"></i>Delivery Fleet (10 Active)</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "AdminFood")"><i class="fa-solid fa-shield-halved text-primary me-2"></i>Admin Portal (7% Fee & Safety)</a></li>
                            <li><hr class="dropdown-divider"></li>
                            <li class="dropdown-header text-uppercase small text-muted">Management & Legacy ERP</li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Stores")"><i class="fa-solid fa-store me-2"></i>Stores CRUD (Legacy)</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("OrderList", "Orders")"><i class="fa-solid fa-list-check me-2"></i>Orders List (Legacy)</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard")"><i class="fa-solid fa-chart-line me-2"></i>General Dashboard</a></li>
                            <li><a class="dropdown-item" href="#" data-bs-toggle="modal" data-bs-target="#dbHealthModal"><i class="fa-solid fa-database text-success me-2"></i>Dual DB Status (2/2 Online)</a></li>
                        </ul>
                    </li>

                </ul>

                <!-- Right Utility Area -->
                <div class="d-flex align-items-center gap-2 gap-md-3 mt-3 mt-lg-0 flex-shrink-0">

                    <!-- Active Delivery State Dropdown -->
                    <div class="dropdown">
                        <button class="btn btn-sm btn-outline-light rounded-pill px-2 px-sm-3 py-1 dropdown-toggle fw-semibold text-nowrap" type="button" id="navStateDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Delivery State (Only restaurants in your state are visible)">
                            <i class="fa-solid fa-location-dot text-danger me-1"></i>
                            <span>@(Session["UserDeliveryState"] != null ? Session["UserDeliveryState"].ToString() : "Delhi")</span>
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="navStateDropdown">
                            <li class="dropdown-header text-uppercase small text-muted">Delivery State Restriction</li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Delhi" })">🏛️ Delhi</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Gujarat" })">🌾 Gujarat</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Maharashtra" })">🌊 Maharashtra</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Rajasthan" })">🏰 Rajasthan</a></li>
                            <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Uttar Pradesh" })">🕌 Uttar Pradesh</a></li>
                        </ul>
                    </div>

                    <!-- Database Health Indicator Modal Trigger -->
                    <button type="button" class="btn p-0 border-0" data-bs-toggle="modal" data-bs-target="#dbHealthModal" title="Dual Database Connectivity Status: Online">
                        <div class="db-health-pill py-1 px-2 text-nowrap">
                            <span class="dot"></span>
                            <span>DBs: 2/2</span>
                        </div>
                    </button>

                    <!-- Notifications Dropdown -->
                    <div class="dropdown">
                        <button class="notification-btn" id="notificationsDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Notifications">
                            <i class="fa-regular fa-bell"></i>
                            <span class="notification-badge" id="navNotifCount">4</span>
                        </button>
                        <div class="dropdown-menu dropdown-menu-end notification-menu p-0" aria-labelledby="notificationsDropdown">
                            <div class="notification-header">
                                <span class="d-flex align-items-center gap-2">
                                    <i class="fa-solid fa-bell text-danger"></i> Notifications
                                </span>
                                <span class="badge bg-danger rounded-pill" id="notifBadgeLabel">4 New</span>
                            </div>
                            <div id="notifListContainer">
                                <div class="notification-item unread">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-dark small"><i class="fa-solid fa-trophy text-warning me-1"></i> Trust Certificate Unlocked!</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">Just now</span>
                                    </div>
                                    <p class="text-muted small mb-0">Royal Biryani completed 215 orders with 4.6★. Download certificate now!</p>
                                </div>
                                <div class="notification-item unread">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-dark small"><i class="fa-solid fa-percent text-success me-1"></i> 7% Platform Fee Earned</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">5m ago</span>
                                    </div>
                                    <p class="text-muted small mb-0">Platform fee collected on Mumbai & Delhi restaurant orders.</p>
                                </div>
                                <div class="notification-item">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-dark small"><i class="fa-solid fa-motorcycle text-primary me-1"></i> 10 Delivery Riders Online</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">15m ago</span>
                                    </div>
                                    <p class="text-muted small mb-0">All 10 Aadhaar-verified riders active across Delhi, Mumbai, Pune, Jaipur.</p>
                                </div>
                                <div class="notification-item">
                                    <div class="d-flex justify-content-between align-items-start mb-1">
                                        <strong class="text-dark small"><i class="fa-solid fa-shield-halved text-danger me-1"></i> Food Safety Audit</strong>
                                        <span class="text-muted" style="font-size: 0.7rem;">1h ago</span>
                                    </div>
                                    <p class="text-muted small mb-0">Urban Wok kitchen in Delhi is pending FSSAI and Hygiene inspection verification.</p>
                                </div>
                            </div>
                            <div class="p-2 text-center bg-light border-top">
                                <button class="btn btn-link btn-sm text-decoration-none text-danger fw-semibold" onclick="clearNotifs()">Mark all as read</button>
                            </div>
                        </div>
                    </div>

                    <!-- User Account / Session -->
                    @if (Session["UserId"] != null)
                    {
                        <div class="dropdown flex-shrink-0">
                            <button class="btn btn-outline-light btn-sm dropdown-toggle rounded-pill px-3 py-1 d-flex align-items-center gap-2 text-nowrap" type="button" id="userMenu" data-bs-toggle="dropdown" aria-expanded="false">
                                <i class="fa-solid fa-circle-user text-warning fs-6"></i>
                                <span class="text-truncate" style="max-width: 100px;">@Session["UserName"]</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-end shadow" aria-labelledby="userMenu">
                                <li class="px-3 py-2 text-muted small border-bottom">
                                    Signed in as<br />
                                    <strong class="text-dark">@Session["UserEmail"]</strong><br />
                                    <span class="badge bg-secondary">@(Session["UserRole"] ?? "User")</span>
                                </li>
                                <li><a class="dropdown-item" href="@Url.Action("MyOrders", "Customer")"><i class="fa-solid fa-clock-rotate-left me-2"></i>My Orders</a></li>
                                @if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Admin")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "AdminFood")"><i class="fa-solid fa-shield-halved me-2"></i>Admin Portal</a></li>
                                }
                                else if (Session["UserRole"] != null && Session["UserRole"].ToString() == "Restaurant")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "Restaurant")"><i class="fa-solid fa-kitchen-set me-2"></i>Restaurant Portal</a></li>
                                }
                                else if (Session["UserRole"] != null && Session["UserRole"].ToString() == "DeliveryAgent")
                                {
                                    <li><a class="dropdown-item" href="@Url.Action("Index", "DeliveryAgent")"><i class="fa-solid fa-motorcycle me-2"></i>Rider Portal</a></li>
                                }
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Dashboard")"><i class="fa-solid fa-gauge me-2"></i>Dashboard</a></li>
                                <li><hr class="dropdown-divider"></li>
                                <li><a class="dropdown-item text-danger" href="@Url.Action("Logout", "Account")"><i class="fa-solid fa-arrow-right-from-bracket me-2"></i>Logout</a></li>
                            </ul>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-shrink-0 text-nowrap">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1">
                                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Login
                            </a>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-danger btn-sm rounded-pill px-3 py-1" style="background-color: #ff4757; border-color: #ff4757;">
                                <i class="fa-solid fa-user-plus me-1"></i> Register
                            </a>
                        </div>
                    }

                </div>

            </div>
        </div>
    </nav>
        </div>
    </nav>

    <!-- Flash Alert Container -->
    <div class="container flash-alert-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-3" role="alert">
                <i class="fa-solid fa-circle-check fs-4 text-success"></i>
                <div class="flex-grow-1 fw-medium">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-4 text-danger"></i>
                <div class="flex-grow-1 fw-medium">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Database Health Modal -->
    <div class="modal fade" id="dbHealthModal" tabindex="-1" aria-labelledby="dbHealthModalLabel" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered">
            <div class="modal-content border-0 shadow-lg rounded-4">
                <div class="modal-header bg-dark text-white rounded-top-4">
                    <h5 class="modal-title d-flex align-items-center gap-2" id="dbHealthModalLabel">
                        <i class="fa-solid fa-database text-warning"></i> Dual Database Connectivity Status
                    </h5>
                    <button type="button" class="btn-close btn-close-white" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body p-4">
                    <p class="text-muted small mb-3">
                        The user highlighted that two databases were involved and one was missing. Both databases are now active, fully mapped, and operational on SQL Server!
                    </p>

                    <!-- DB 1: AssignmentDB -->
                    <div class="card border rounded-3 p-3 mb-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark"><i class="fa-solid fa-server text-primary me-2"></i>AssignmentDB (Primary Food & Store DB)</span>
                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Online</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="fa-solid fa-angle-right text-success me-1"></i>Tables: <code>hra.Stores</code>, <code>hra.Orders</code>, <code>hra.MenuItems</code>, <code>hra.Reviews</code>, <code>hra.DeliveryAgents</code>, <code>dbo.UserTbl</code></li>
                            <li><i class="fa-solid fa-angle-right text-success me-1"></i>Status: Connected via <code>sa</code> user on localhost</li>
                        </ul>
                    </div>

                    <!-- DB 2: Practice -->
                    <div class="card border rounded-3 p-3 bg-light">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="fw-bold text-dark"><i class="fa-solid fa-database text-success me-2"></i>Practice DB (Previously Missing LMS DB)</span>
                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Restored & Active</span>
                        </div>
                        <ul class="list-unstyled small text-muted mb-0">
                            <li><i class="fa-solid fa-angle-right text-success me-1"></i>Tables: <code>LMS.Users</code>, <code>LMS.Courses</code>, <code>LMS.Payments</code>, <code>LMS.Reviews</code>, <code>LMS.QuizQuestions</code></li>
                            <li><i class="fa-solid fa-angle-right text-success me-1"></i>Status: Restored and seeded with all stored procedures</li>
                        </ul>
                    </div>
                </div>
                <div class="modal-footer border-top-0 pt-0">
                    <button type="button" class="btn btn-secondary rounded-pill btn-sm" data-bs-dismiss="modal">Close</button>
                </div>
            </div>
        </div>
    </div>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 mb-3">
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-shield-halved text-success"></i> 100% FSSAI Hygiene Verified</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-id-card text-info"></i> Aadhaar-Verified Delivery Fleet</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-percent text-warning"></i> 7% Platform Fee Transparency</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-medal text-warning"></i> 200+ Orders Trust Certification</span>
            </div>
            <div class="text-secondary small">
                © @DateTime.Now.Year <strong>FoodExpress & Order Management System</strong>. Built with ASP.NET MVC & SQL Server.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // Auto-dismiss alerts after 4 seconds
        setTimeout(function () {
            $(".alert").fadeOut("slow");
        }, 4000);

        function clearNotifs() {
            $("#navNotifCount").text("0").hide();
            $("#notifBadgeLabel").text("0 New");
            $(".notification-item.unread").removeClass("unread");
        }
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>
