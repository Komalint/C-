<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewBag.Title - FoodExpress | Online Food Delivery & Restaurant Platform</title>

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Plus+Jakarta+Sans:wght@300;400;500;600;700;800&display=swap" rel="stylesheet">

    <!-- Bootstrap 5 CSS -->
    @Styles.Render("~/Content/css")

    <!-- Font Awesome 6.5.1 -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.5.1/css/all.min.css" integrity="sha512-DTOQO9RWCH3ppGqcWaEA1BIZOC6xxalwEsw9c2QQeAIftl+Vegovlnee1c9QX4TctnWMn13TZye+giMm8e2LwA==" crossorigin="anonymous" referrerpolicy="no-referrer" />
    <!-- Bootstrap Icons Fallback -->
    <link rel="stylesheet" href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.11.3/font/bootstrap-icons.min.css">

    @Scripts.Render("~/bundles/modernizr")

    <style>
        :root {
            --primary-food: #ff4757;
            --primary-hover: #e04050;
            --primary-subtle: #fff1f2;
            --accent-gold: #f59e0b;
            --dark-surface: #0f172a;
            --card-radius: 16px;
        }

        html, body {
            max-width: 100vw;
            overflow-x: hidden;
        }

        body {
            font-family: 'Plus Jakarta Sans', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: #f8fafc;
            color: #1e293b;
            min-height: 100vh;
            display: flex;
            flex-direction: column;
            overflow-x: hidden;
        }

        /* Navbar Styling */
        .navbar-brand-food {
            font-weight: 800;
            font-size: 1.45rem;
            letter-spacing: -0.5px;
            color: #ffffff !important;
            display: flex;
            align-items: center;
            gap: 10px;
        }
        .navbar-brand-food .brand-icon {
            width: 38px;
            height: 38px;
            background: linear-gradient(135deg, #ff6b81, #ff4757);
            border-radius: 10px;
            display: flex;
            align-items: center;
            justify-content: center;
            color: white;
            box-shadow: 0 4px 12px rgba(255, 71, 87, 0.4);
        }

        .main-nav {
            background: #111827;
            border-bottom: 1px solid rgba(255,255,255,0.08);
            box-shadow: 0 4px 20px rgba(0,0,0,0.08);
        }

        .nav-link-custom {
            color: #cbd5e1 !important;
            font-weight: 500;
            font-size: 0.92rem;
            padding: 8px 14px !important;
            border-radius: 10px;
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            gap: 8px;
        }
        .nav-link-custom:hover {
            color: #ffffff !important;
            background: rgba(255, 255, 255, 0.08);
        }
        .nav-link-custom.active {
            color: #ffffff !important;
            background: #ff4757;
            font-weight: 600;
            box-shadow: 0 2px 10px rgba(255, 71, 87, 0.35);
        }

        /* Notification Badge */
        .notification-btn {
            position: relative;
            background: rgba(255,255,255,0.08);
            border: 1px solid rgba(255,255,255,0.12);
            color: white;
            border-radius: 12px;
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            transition: all 0.2s;
        }
        .notification-btn:hover {
            background: rgba(255,255,255,0.18);
            color: white;
        }
        .notification-badge {
            position: absolute;
            top: -4px;
            right: -4px;
            background: #ff4757;
            color: white;
            font-size: 0.7rem;
            font-weight: 700;
            padding: 2px 6px;
            border-radius: 10px;
            border: 2px solid #111827;
        }

        /* Notifications Dropdown Panel */
        .notification-menu {
            position: absolute !important;
            top: calc(100% + 10px) !important;
            right: 0 !important;
            left: auto !important;
            width: 380px !important;
            max-width: 90vw !important;
            max-height: 480px !important;
            overflow-y: auto !important;
            background: #ffffff !important;
            color: #1e293b !important;
            border-radius: 16px !important;
            box-shadow: 0 16px 45px rgba(0,0,0,0.28) !important;
            border: 1px solid #e2e8f0 !important;
            padding: 0 !important;
            display: none;
            z-index: 10000 !important;
        }
        .notification-menu.show {
            display: block !important;
            opacity: 1 !important;
            visibility: visible !important;
        }
        .notification-header {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            font-weight: 700;
            display: flex;
            justify-content: space-between;
            align-items: center;
            background: #f8fafc;
        }
        .notification-item {
            padding: 12px 16px;
            border-bottom: 1px solid #f1f5f9;
            transition: background 0.15s;
        }
        .notification-item:hover {
            background: #f8fafc;
        }
        .notification-item.unread {
            background: #fff5f5;
        }

        /* Food Card styles */
        .food-card {
            background: white;
            border-radius: var(--card-radius);
            border: 1px solid #e2e8f0;
            transition: transform 0.2s, box-shadow 0.2s;
            overflow: hidden;
        }
        .food-card:hover {
            transform: translateY(-4px);
            box-shadow: 0 14px 28px rgba(0,0,0,0.06);
        }

        /* Flash Alerts */
        .flash-alert-container {
            margin-top: 15px;
        }

        /* Footer */
        footer {
            margin-top: auto;
            background: #111827;
            color: #94a3b8;
            border-top: 1px solid rgba(255,255,255,0.08);
            font-size: 0.9rem;
        }
    </style>
    @RenderSection("styles", required: false)
</head>
<body>

    @{
        string rawRole = (Session["UserRole"] != null ? Session["UserRole"].ToString() : "").Trim();
        string loginRole = (Session["LoginRole"] != null ? Session["LoginRole"].ToString() : rawRole).Trim();
        string activeTab = ViewBag.ActiveTab != null ? ViewBag.ActiveTab.ToString() : "";
        bool isRestaurant = loginRole.Equals("Restaurant", StringComparison.OrdinalIgnoreCase) || rawRole.Equals("Restaurant", StringComparison.OrdinalIgnoreCase);
        bool isAdmin = loginRole.Equals("Admin", StringComparison.OrdinalIgnoreCase) || rawRole.Equals("Admin", StringComparison.OrdinalIgnoreCase);
        bool isRider = loginRole.Equals("DeliveryAgent", StringComparison.OrdinalIgnoreCase) || loginRole.Equals("Rider", StringComparison.OrdinalIgnoreCase) || rawRole.Equals("DeliveryAgent", StringComparison.OrdinalIgnoreCase) || rawRole.Equals("Rider", StringComparison.OrdinalIgnoreCase);
        bool isCustomer = !isRestaurant && !isAdmin && !isRider;
        bool isAuthenticated = Session["UserId"] != null;
    }

    <!-- Main Navigation Bar (Dedicated Role-Based Design) -->
    <nav class="navbar navbar-expand-lg navbar-dark main-nav sticky-top">
        <div class="container-fluid px-2 px-sm-3 px-xl-4">

            @if (isRestaurant)
            {
                <!-- RESTAURANT PARTNER NAVBAR BRAND -->
                <a href="@Url.Action("Index", "Restaurant")" class="navbar-brand navbar-brand-food me-2 me-lg-3 flex-shrink-0">
                    <div class="brand-icon" style="background: linear-gradient(135deg, #ff6b81, #ff4757);">
                        <i class="fa-solid fa-kitchen-set"></i>
                    </div>
                    <span>Food<span style="color: #ff4757;">Express</span> <span class="badge bg-danger rounded-pill px-2 py-1 ms-1 text-white fw-bold" style="font-size: 0.7rem; background-color: #ff4757 !important;">KITCHEN PARTNER</span></span>
                </a>
            }
            else if (isAdmin)
            {
                <!-- ADMIN CONSOLE NAVBAR BRAND -->
                <a href="@Url.Action("Index", "AdminFood")" class="navbar-brand navbar-brand-food me-2 me-lg-3 flex-shrink-0">
                    <div class="brand-icon" style="background: linear-gradient(135deg, #3b82f6, #1d4ed8);">
                        <i class="fa-solid fa-shield-halved"></i>
                    </div>
                    <span>Food<span style="color: #3b82f6;">Express</span> <span class="badge bg-primary rounded-pill px-2 py-1 ms-1 text-white fw-bold" style="font-size: 0.7rem;">ADMIN CONSOLE</span></span>
                </a>
            }
            else if (isRider)
            {
                <!-- DELIVERY FLEET NAVBAR BRAND -->
                <a href="@Url.Action("Index", "DeliveryAgent")" class="navbar-brand navbar-brand-food me-2 me-lg-3 flex-shrink-0">
                    <div class="brand-icon" style="background: linear-gradient(135deg, #10b981, #059669);">
                        <i class="fa-solid fa-motorcycle"></i>
                    </div>
                    <span>Food<span style="color: #10b981;">Express</span> <span class="badge bg-success rounded-pill px-2 py-1 ms-1 text-white fw-bold" style="font-size: 0.7rem;">RIDER FLEET</span></span>
                </a>
            }
            else
            {
                <!-- CUSTOMER / GUEST NAVBAR BRAND -->
                <a href="@Url.Action("Index", "Customer")" class="navbar-brand navbar-brand-food me-2 me-lg-3 flex-shrink-0">
                    <div class="brand-icon">
                        <i class="fa-solid fa-utensils"></i>
                    </div>
                    <span>Food<span style="color: #ff4757;">Express</span></span>
                </a>
            }

            <!-- Mobile Toggle -->
            <button class="navbar-toggler border-0" type="button" data-bs-toggle="collapse" data-bs-target="#foodNavbar" aria-controls="foodNavbar" aria-expanded="false" aria-label="Toggle navigation">
                <i class="fa-solid fa-bars text-white"></i>
            </button>

            <!-- Navbar Links Container -->
            <div class="collapse navbar-collapse" id="foodNavbar">

                @if (isRestaurant)
                {
                    <!-- DEDICATED RESTAURANT KITCHEN NAVIGATION LINKS ONLY -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantOrders" || activeTab == "Restaurant" ? "active" : "")" href="@Url.Action("Index", "Restaurant")">
                                <i class="fa-solid fa-fire text-danger"></i>
                                <span>Kitchen Queue</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantMenu" ? "active" : "")" href="@Url.Action("ManageMenu", "Restaurant")">
                                <i class="fa-solid fa-book-open text-warning"></i>
                                <span>Menu CRUD</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantInvoices" ? "active" : "")" href="@Url.Action("Invoices", "Restaurant")">
                                <i class="fa-solid fa-file-invoice-dollar text-success"></i>
                                <span>Invoices & 7% Fee</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantReviews" ? "active" : "")" href="@Url.Action("Reviews", "Restaurant")">
                                <i class="fa-solid fa-comments text-info"></i>
                                <span>Customer Reviews</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantCert" ? "active" : "")" href="@Url.Action("Certificate", "Restaurant")">
                                <i class="fa-solid fa-award text-warning"></i>
                                <span>Trust Certificate</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "RestaurantSettings" ? "active" : "")" href="@Url.Action("EditProfile", "Restaurant")">
                                <i class="fa-solid fa-sliders text-info"></i>
                                <span>Kitchen Settings & Banner</span>
                            </a>
                        </li>
                    </ul>
                }
                else if (isAdmin)
                {
                    <!-- DEDICATED ADMIN PORTAL NAVIGATION LINKS -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "Admin" ? "active" : "")" href="@Url.Action("Index", "AdminFood")">
                                <i class="fa-solid fa-shield-halved text-primary"></i>
                                <span>Admin Overview & Analytics</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("Index", "Stores")">
                                <i class="fa-solid fa-store text-warning"></i>
                                <span>Registered Stores</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("Index", "DeliveryAgent")">
                                <i class="fa-solid fa-motorcycle text-success"></i>
                                <span>Delivery Fleet (10 Active)</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("OrderList", "Orders")">
                                <i class="fa-solid fa-list-check text-info"></i>
                                <span>All Platform Orders</span>
                            </a>
                        </li>
                    </ul>
                }
                else if (isRider)
                {
                    <!-- DEDICATED RIDER FLEET NAVIGATION LINKS -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "DeliveryAgent" ? "active" : "")" href="@Url.Action("Index", "DeliveryAgent")">
                                <i class="fa-solid fa-motorcycle text-success"></i>
                                <span>Rider Trips & Route</span>
                            </a>
                        </li>
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom" href="@Url.Action("Index", "DeliveryAgent")">
                                <i class="fa-solid fa-wallet text-warning"></i>
                                <span>Earnings Wallet (&#8377;60/Trip)</span>
                            </a>
                        </li>
                    </ul>
                }
                else
                {
                    <!-- DEDICATED CUSTOMER NAVIGATION LINKS -->
                    <ul class="navbar-nav me-auto mb-2 mb-lg-0 gap-1">
                        <li class="nav-item">
                            <a class="nav-link nav-link-custom @(activeTab == "Customer" ? "active" : "")" href="@Url.Action("Index", "Customer")">
                                <i class="fa-solid fa-bowl-food text-warning"></i>
                                <span>Explore Food</span>
                            </a>
                        </li>
                        @if (isAuthenticated && isCustomer)
                        {
                            <li class="nav-item">
                                <a class="nav-link nav-link-custom" href="@Url.Action("MyOrders", "Customer")">
                                    <i class="fa-solid fa-receipt text-info"></i>
                                    <span>My Orders</span>
                                </a>
                            </li>
                        }
                    </ul>
                }

                <!-- Right Utility Area -->
                <div class="d-flex align-items-center gap-2 gap-md-3 mt-3 mt-lg-0 flex-shrink-0">

                    @if (isCustomer)
                    {
                        <!-- Active Delivery State Dropdown (Shown only to Customers) -->
                        <div class="dropdown">
                            <button class="btn btn-sm btn-outline-light rounded-pill px-2 px-sm-3 py-1 dropdown-toggle fw-semibold text-nowrap" type="button" id="navStateDropdown" data-bs-toggle="dropdown" aria-expanded="false" title="Switch Delivery State (Only restaurants in your state are visible)">
                                <i class="fa-solid fa-location-dot text-danger me-1"></i>
                                <span>@(Session["UserDeliveryState"] != null ? Session["UserDeliveryState"].ToString() : "Delhi")</span>
                            </button>
                            <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="navStateDropdown">
                                <li class="dropdown-header text-uppercase small text-muted">Delivery State Restriction</li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Delhi" })">🏛️ Delhi</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Gujarat" })">🌾 Gujarat</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Maharashtra" })">🌊 Maharashtra</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Rajasthan" })">🏰 Rajasthan</a></li>
                                <li><a class="dropdown-item" href="@Url.Action("Index", "Customer", new { state = "Uttar Pradesh" })">🕌 Uttar Pradesh</a></li>
                            </ul>
                        </div>
                    }

                    @if (isAuthenticated)
                    {
                        <!-- Notifications Dropdown (Live Real-Time Integration - Only for Logged In Users) -->
                        <div class="dropdown flex-shrink-0 position-relative">
                            <button type="button" class="notification-btn" id="notificationsDropdown" aria-expanded="false" title="Notifications">
                                <i class="fa-regular fa-bell"></i>
                                <span class="notification-badge" id="navNotifCount" style="display: none;">0</span>
                            </button>
                            <div class="dropdown-menu dropdown-menu-end notification-menu p-0 shadow-lg" id="notificationsMenu" aria-labelledby="notificationsDropdown">
                                <div class="notification-header">
                                    <span class="d-flex align-items-center gap-2">
                                        <i class="fa-solid fa-bell text-danger"></i> Live Notifications
                                    </span>
                                    <span class="badge bg-danger rounded-pill" id="notifBadgeLabel">0 New</span>
                                </div>
                                <div id="notifListContainer">
                                    <div class="p-4 text-center text-muted small">
                                        <div class="spinner-border spinner-border-sm text-danger mb-2" role="status"></div>
                                        <p class="mb-0">Loading recent notifications...</p>
                                    </div>
                                </div>
                                <div class="p-2 text-center bg-light border-top">
                                    <button type="button" class="btn btn-link btn-sm text-decoration-none text-danger fw-semibold" onclick="markAllNotificationsRead()">
                                        <i class="fa-solid fa-check-double me-1"></i> Mark all as read
                                    </button>
                                </div>
                            </div>
                        </div>

                        <!-- User Account Menu & Direct Visible Logout -->
                        <div class="d-flex align-items-center gap-2 flex-shrink-0">
                            <!-- Active User Dropdown with Profile Access -->
                            <div class="dropdown">
                                <button class="btn btn-sm btn-dark border border-secondary border-opacity-50 rounded-pill px-2 px-sm-3 py-1 dropdown-toggle text-light small fw-bold d-inline-flex align-items-center gap-1" type="button" id="userMenuDropdown" data-bs-toggle="dropdown" aria-expanded="false">
                                    <i class="fa-solid fa-circle-user text-warning fs-6"></i>
                                    <span class="text-truncate" style="max-width: 110px;">@Session["UserName"]</span>
                                </button>
                                <ul class="dropdown-menu dropdown-menu-dark dropdown-menu-end shadow" aria-labelledby="userMenuDropdown">
                                    @if (isCustomer)
                                    {
                                        <li>
                                            <a class="dropdown-item py-2" href="@Url.Action("Profile", "Customer")">
                                                <i class="fa-solid fa-id-card text-info me-2"></i> My Profile & Address
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item py-2" href="@Url.Action("MyOrders", "Customer")">
                                                <i class="fa-solid fa-receipt text-warning me-2"></i> My Orders
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                    }
                                    <li>
                                        <a class="dropdown-item text-danger py-2" href="@Url.Action("Logout", "Account")">
                                            <i class="fa-solid fa-arrow-right-from-bracket me-2"></i> Logout
                                        </a>
                                    </li>
                                </ul>
                            </div>

                            <!-- PROMINENT DIRECT VISIBLE LOGOUT BUTTON -->
                            <a href="@Url.Action("Logout", "Account")" class="btn btn-danger btn-sm rounded-pill px-3 py-1 fw-bold text-white shadow-sm d-inline-flex align-items-center gap-1 flex-shrink-0" style="background-color: #ff4757 !important; border-color: #ff4757 !important;" title="Sign out of FoodExpress">
                                <i class="fa-solid fa-arrow-right-from-bracket"></i>
                                <span>Logout</span>
                            </a>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-items-center gap-2 flex-shrink-0 text-nowrap">
                            <a href="@Url.Action("Login", "Account")" class="btn btn-outline-light btn-sm rounded-pill px-3 py-1">
                                <i class="fa-solid fa-arrow-right-to-bracket me-1"></i> Login
                            </a>
                            <a href="@Url.Action("Register", "Account")" class="btn btn-danger btn-sm rounded-pill px-3 py-1" style="background-color: #ff4757; border-color: #ff4757;">
                                <i class="fa-solid fa-user-plus me-1"></i> Register
                            </a>
                        </div>
                    }

                </div>

            </div>
        </div>
    </nav>

    <!-- Flash Alert Container -->
    <div class="container flash-alert-container">
        @if (TempData["SuccessMessage"] != null)
        {
            <div class="alert alert-success alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-3" role="alert">
                <i class="fa-solid fa-circle-check fs-4 text-success"></i>
                <div class="flex-grow-1 fw-medium">@TempData["SuccessMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
        @if (TempData["ErrorMessage"] != null)
        {
            <div class="alert alert-danger alert-dismissible fade show border-0 shadow-sm rounded-4 d-flex align-items-center gap-3" role="alert">
                <i class="fa-solid fa-triangle-exclamation fs-4 text-danger"></i>
                <div class="flex-grow-1 fw-medium">@TempData["ErrorMessage"]</div>
                <button type="button" class="btn-close" data-bs-dismiss="alert" aria-label="Close"></button>
            </div>
        }
    </div>

    <!-- Main Content Body -->
    <main class="flex-grow-1">
        @RenderBody()
    </main>

    <!-- Footer -->
    <footer class="py-4 mt-5">
        <div class="container text-center">
            <div class="d-flex flex-wrap justify-content-center align-items-center gap-4 mb-3">
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-shield-halved text-success"></i> 100% FSSAI Hygiene Verified</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-id-card text-info"></i> Aadhaar-Verified Delivery Fleet</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-percent text-warning"></i> 7% Platform Fee Transparency</span>
                <span class="d-flex align-items-center gap-2"><i class="fa-solid fa-medal text-warning"></i> 200+ Orders Trust Certification</span>
            </div>
            <div class="text-secondary small">
                © @DateTime.Now.Year <strong>FoodExpress & Order Management System</strong>. Built with ASP.NET MVC & SQL Server.
            </div>
        </div>
    </footer>

    <!-- Scripts -->
    @Scripts.Render("~/bundles/jquery")
    @Scripts.Render("~/bundles/bootstrap")

    <script>
        // Auto-dismiss alerts after 4 seconds
        setTimeout(function () {
            $(".alert").fadeOut("slow");
        }, 4000);

        // Real-Time Notification Engine
        function getEffectiveRole() {
            const path = window.location.pathname.toLowerCase();
            if (path.indexOf('/restaurant') >= 0) return 'Restaurant';
            if (path.indexOf('/admin') >= 0) return 'Admin';
            if (path.indexOf('/delivery') >= 0) return 'DeliveryAgent';
            const sessRole = '@(Session["LoginRole"] ?? Session["UserRole"] ?? "")';
            return sessRole ? sessRole : 'Customer';
        }

        function loadRealtimeNotifications() {
            @if (!isAuthenticated)
            {
                <text>return;</text>
            }
            const roleToQuery = getEffectiveRole();
            $.ajax({
                url: '@Url.Action("GetRecent", "Notification")',
                type: 'GET',
                data: { role: roleToQuery },
                dataType: 'json',
                success: function (data) {
                    if (!data || !data.success) return;

                    const countBadge = $("#navNotifCount");
                    const labelBadge = $("#notifBadgeLabel");
                    const container = $("#notifListContainer");

                    if (data.unreadCount > 0) {
                        countBadge.text(data.unreadCount).show();
                        labelBadge.text(data.unreadCount + " New");
                    } else {
                        countBadge.hide();
                        labelBadge.text("0 New");
                    }

                    if (data.notifications && data.notifications.length > 0) {
                        let html = "";
                        data.notifications.forEach(function (n) {
                            let icon = "fa-solid fa-bell text-danger";
                            if (n.NotificationType === "OrderUpdate") icon = "fa-solid fa-fire text-danger";
                            else if (n.NotificationType === "Payment") icon = "fa-solid fa-percent text-success";
                            else if (n.NotificationType === "System") icon = "fa-solid fa-award text-warning";
                            else if (n.NotificationType === "Safety") icon = "fa-solid fa-shield-halved text-primary";

                            html += `
                            <div class="notification-item ${n.IsRead ? '' : 'unread'}" style="cursor: pointer;" onclick="markSingleNotifRead(${n.NotificationId}, this)">
                                <div class="d-flex justify-content-between align-items-start mb-1">
                                    <strong class="text-dark small"><i class="${icon} me-1"></i> ${escapeNotifHtml(n.Title)}</strong>
                                    <span class="text-muted" style="font-size: 0.7rem;">${n.TimeAgo}</span>
                                </div>
                                <p class="text-muted small mb-0">${escapeNotifHtml(n.Message)}</p>
                            </div>`;
                        });
                        container.html(html);
                    } else {
                        container.html('<div class="p-4 text-center text-muted small"><i class="fa-regular fa-bell-slash fs-4 d-block mb-2 text-secondary opacity-50"></i>No notifications yet. New updates will appear here in real time.</div>');
                    }

                    // If on Restaurant Dashboard, also sync the in-dashboard Kitchen Alerts tab
                    const dashBadge = $("#dashNotifBadge");
                    if (dashBadge.length) {
                        dashBadge.text(data.unreadCount);
                        dashBadge.attr("class", data.unreadCount > 0 ? "badge bg-danger rounded-pill ms-1" : "badge bg-secondary rounded-pill ms-1");
                    }
                    const dashTable = $("#dashNotifTableBody");
                    if (dashTable.length && data.notifications) {
                        if (data.notifications.length === 0) {
                            dashTable.html('<tr><td colspan="5" class="text-center py-4 text-muted">No notifications recorded yet.</td></tr>');
                        } else {
                            let rows = "";
                            data.notifications.forEach(function (n) {
                                let badge = n.IsRead ? '<span class="badge bg-light text-secondary border">Read</span>' : '<span class="badge bg-danger">New Unread</span>';
                                rows += `
                                <tr class="${n.IsRead ? '' : 'table-danger bg-opacity-10'}">
                                    <td>${badge}</td>
                                    <td class="fw-bold">${escapeNotifHtml(n.Title)}</td>
                                    <td>${escapeNotifHtml(n.Message)}</td>
                                    <td class="small text-muted text-nowrap">${n.CreatedAt}</td>
                                    <td>
                                        ${n.IsRead ? '' : `<button type="button" class="btn btn-outline-danger btn-sm rounded-pill py-0 px-2" onclick="markSingleNotifRead(${n.NotificationId}, this)">Mark Read</button>`}
                                    </td>
                                </tr>`;
                            });
                            dashTable.html(rows);
                        }
                    }
                }
            });
        }

        function markSingleNotifRead(id, element) {
            $.post('@Url.Action("MarkRead", "Notification")', { id: id }, function () {
                $(element).removeClass("unread");
                loadRealtimeNotifications();
            });
        }

        function markAllNotificationsRead() {
            $.post('@Url.Action("MarkAllRead", "Notification")', { role: getEffectiveRole() }, function () {
                loadRealtimeNotifications();
            });
        }

        function escapeNotifHtml(str) {
            if (!str) return "";
            return $("<div>").text(str).html();
        }

        // Initialize and bulletproof click toggle
        $(document).ready(function () {
            loadRealtimeNotifications();
            setInterval(loadRealtimeNotifications, 4000);

            // Click listener for bell icon
            $(document).on('click', '#notificationsDropdown', function (e) {
                e.preventDefault();
                e.stopPropagation();
                const $menu = $('#notificationsMenu');
                const isShown = $menu.hasClass('show');
                $('.dropdown-menu').not('#notificationsMenu').removeClass('show');
                if (!isShown) {
                    $menu.addClass('show');
                    $(this).attr('aria-expanded', 'true');
                    loadRealtimeNotifications();
                } else {
                    $menu.removeClass('show');
                    $(this).attr('aria-expanded', 'false');
                }
            });

            // Close when clicking outside
            $(document).on('click', function (e) {
                if (!$(e.target).closest('#notificationsDropdown, #notificationsMenu').length) {
                    $('#notificationsMenu').removeClass('show');
                    $('#notificationsDropdown').attr('aria-expanded', 'false');
                }
            });
        });
    </script>

    @RenderSection("scripts", required: false)

</body>
</html>
