@model MVConFramework.Models.DeliveryAgent
@{
    ViewBag.Title = "Enroll as Delivery Partner - Aadhaar KYC Verification";
}

<div class="py-4">
    <div class="row justify-content-center">
        <div class="col-lg-7">

            <div class="card border-0 rounded-4 shadow-lg p-5 bg-white">
                <div class="text-center mb-4">
                    <div class="bg-success text-white rounded-circle p-3 d-inline-flex align-items-center justify-content-center mb-2" style="width: 65px; height: 65px;">
                        <i class="fa-solid fa-motorcycle fs-3"></i>
                    </div>
                    <h3 class="fw-extrabold text-dark mb-1">Enroll as a Delivery Partner</h3>
                    <p class="text-muted small">Simple, instant onboarding with real-time Aadhaar verification. Earn &#8377;60+ per delivery trip!</p>
                </div>

                @using (Html.BeginForm("Enroll", "DeliveryAgent", FormMethod.Post))
                {
                    @Html.AntiForgeryToken()

                    <div class="row g-3">

                        <!-- Full Name -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Rider Full Name</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-user text-muted"></i></span>
                                <input type="text" name="FullName" class="form-control" placeholder="e.g. Arjun Sharma" required />
                            </div>
                        </div>

                        <!-- Phone Number -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Mobile Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-phone text-muted"></i></span>
                                <input type="tel" name="PhoneNumber" class="form-control" placeholder="10-digit mobile" maxlength="10" required />
                            </div>
                        </div>

                        <!-- Email -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Email Address</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-envelope text-muted"></i></span>
                                <input type="email" name="Email" class="form-control" placeholder="rider@express.com" required />
                            </div>
                        </div>

                        <!-- City -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Operating City</label>
                            <select name="City" class="form-select rounded-3">
                                <option value="Delhi">Delhi</option>
                                <option value="Mumbai">Mumbai</option>
                                <option value="Pune">Pune</option>
                                <option value="Jaipur">Jaipur</option>
                                <option value="Lucknow">Lucknow</option>
                                <option value="Bangalore">Bangalore</option>
                            </select>
                        </div>

                        <!-- Aadhaar Number (Crucial Requirement) -->
                        <div class="col-12">
                            <label class="form-label small fw-semibold">12-Digit Aadhaar Number (Government Identity Verification)</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-id-card text-success"></i></span>
                                <input type="text" name="AadhaarNumber" id="aadhaarInput" class="form-control" placeholder="XXXX XXXX XXXX (12 numeric digits)" maxlength="14" oninput="formatAadhaar(this)" required />
                                <button type="button" class="btn btn-outline-success" onclick="verifyAadhaarMock()"><i class="fa-solid fa-check-circle me-1"></i> Verify Aadhaar</button>
                            </div>
                            <small class="text-success mt-1 d-block" id="aadhaarStatusMsg">
                                <i class="fa-solid fa-circle-check"></i> Instant UIDAI identity verification active.
                            </small>
                        </div>

                        <!-- Vehicle Type & Number -->
                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vehicle Type</label>
                            <select name="VehicleType" class="form-select rounded-3">
                                <option value="Motorcycle">Motorcycle / Bike</option>
                                <option value="EV Scooter">EV Scooter (Electric)</option>
                                <option value="Scooter">Scooter (Automatic)</option>
                                <option value="Bicycle">Bicycle / E-Cycle</option>
                            </select>
                        </div>

                        <div class="col-md-6">
                            <label class="form-label small fw-semibold">Vehicle Registration Number</label>
                            <div class="input-group">
                                <span class="input-group-text bg-white"><i class="fa-solid fa-car text-muted"></i></span>
                                <input type="text" name="VehicleNumber" class="form-control text-uppercase" placeholder="e.g. DL-01-AB-1234" required />
                            </div>
                        </div>

                        <!-- Submit Button -->
                        <div class="col-12 pt-3">
                            <button type="submit" class="btn btn-success btn-lg w-100 rounded-pill fw-bold shadow-sm py-3">
                                <i class="fa-solid fa-circle-check me-2"></i> Complete Aadhaar KYC & Start Delivering
                            </button>
                        </div>

                        <div class="col-12 text-center text-muted small">
                            Already enrolled? <a href="@Url.Action("Index", "DeliveryAgent")" class="text-success fw-bold text-decoration-none">Open Delivery Partner Dashboard</a>
                        </div>

                    </div>
                }
            </div>

        </div>
    </div>
</div>

@section scripts {
    <script>
        function formatAadhaar(input) {
            let val = input.value.replace(/\D/g, '');
            let formatted = val.match(/.{1,4}/g)?.join(' ') || '';
            input.value = formatted.substring(0, 14);
        }

        function verifyAadhaarMock() {
            const raw = $("#aadhaarInput").val().replace(/\s/g, '');
            if (raw.length === 12) {
                $("#aadhaarStatusMsg").html('<i class="fa-solid fa-check-double text-success"></i> Aadhaar ' + raw.substring(0, 4) + ' **** **** verified successfully with UIDAI database.');
                alert("Aadhaar verified successfully!");
            } else {
                alert("Please enter a valid 12-digit Aadhaar number.");
            }
        }
    </script>
}
