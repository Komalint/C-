@model MVConFramework.ViewModels.LoginViewModel

@{
    ViewBag.Title = "Role-Based Authentication Login";
    string currentRole = !string.IsNullOrEmpty(Model.LoginRole) ? Model.LoginRole : "Customer";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-lg-7 col-xl-6">

            <!-- Card Header & Brand -->
            <div class="card border-0 rounded-4 shadow-lg overflow-hidden bg-white">
                <div class="p-4 text-white text-center" style="background: linear-gradient(135deg, #1e293b 0%, #0f172a 100%);">
                    <div class="brand-icon mx-auto mb-2" style="width: 52px; height: 52px; background: linear-gradient(135deg, #ff6b81, #ff4757); border-radius: 14px; display: flex; align-items: center; justify-content: center; box-shadow: 0 4px 15px rgba(255, 71, 87, 0.4);">
                        <i class="fa-solid fa-utensils fs-4 text-white"></i>
                    </div>
                    <h3 class="fw-extrabold mb-1">Food<span style="color: #ff4757;">Express</span> Secure Login</h3>
                    <p class="text-light small mb-0 opacity-75">Role-Based Access Control for Customers, Kitchens, Fleet &amp; Administrators</p>
                </div>

                <div class="card-body p-4 p-md-5">

                    @if (TempData["SuccessMessage"] != null)
                    {
                        <div class="alert alert-success border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-circle-check fs-5 text-success"></i>
                            <div>@TempData["SuccessMessage"]</div>
                        </div>
                    }

                    @if (TempData["ErrorMessage"] != null)
                    {
                        <div class="alert alert-danger border-0 shadow-sm rounded-3 mb-4 d-flex align-items-center gap-2">
                            <i class="fa-solid fa-triangle-exclamation fs-5 text-danger"></i>
                            <div>@TempData["ErrorMessage"]</div>
                        </div>
                    }

                    <!-- Role Selection Header (Login As ...) -->
                    <div class="mb-4">
                        <label class="form-label small fw-bold text-muted text-uppercase mb-2">
                            <i class="fa-solid fa-id-badge text-danger me-1"></i> 1. Select Who You Are Logging In As:
                        </label>
                        <div class="row g-2">
                            <div class="col-6 col-sm-3">
                                <button type="button" class="btn w-100 rounded-3 p-2 text-center border role-pill-btn @(currentRole == "Customer" ? "btn-danger fw-bold shadow-sm" : "btn-light")" onclick="selectRole('Customer')">
                                    <i class="fa-solid fa-user d-block fs-5 mb-1"></i>
                                    <span class="small d-block">Customer</span>
                                </button>
                            </div>
                            <div class="col-6 col-sm-3">
                                <button type="button" class="btn w-100 rounded-3 p-2 text-center border role-pill-btn @(currentRole == "Restaurant" ? "btn-danger fw-bold shadow-sm" : "btn-light")" onclick="selectRole('Restaurant')">
                                    <i class="fa-solid fa-kitchen-set d-block fs-5 mb-1"></i>
                                    <span class="small d-block">Restaurant</span>
                                </button>
                            </div>
                            <div class="col-6 col-sm-3">
                                <button type="button" class="btn w-100 rounded-3 p-2 text-center border role-pill-btn @(currentRole == "DeliveryAgent" ? "btn-danger fw-bold shadow-sm" : "btn-light")" onclick="selectRole('DeliveryAgent')">
                                    <i class="fa-solid fa-motorcycle d-block fs-5 mb-1"></i>
                                    <span class="small d-block">Rider</span>
                                </button>
                            </div>
                            <div class="col-6 col-sm-3">
                                <button type="button" class="btn w-100 rounded-3 p-2 text-center border role-pill-btn @(currentRole == "Admin" ? "btn-danger fw-bold shadow-sm" : "btn-light")" onclick="selectRole('Admin')">
                                    <i class="fa-solid fa-shield-halved d-block fs-5 mb-1"></i>
                                    <span class="small d-block">Admin</span>
                                </button>
                            </div>
                        </div>
                    </div>

                    <!-- One-Click Quick Fill Demo Credentials -->
                    <div class="bg-light p-3 rounded-4 border mb-4">
                        <div class="d-flex justify-content-between align-items-center mb-2">
                            <span class="small fw-bold text-dark"><i class="fa-solid fa-wand-magic-sparkles text-danger me-1"></i> Quick Demo Logins (1-Click Fill):</span>
                            <span class="badge bg-secondary rounded-pill small">Auto-Fill</span>
                        </div>
                        <div class="d-flex flex-wrap gap-2">
                            <button type="button" class="btn btn-sm btn-outline-dark rounded-pill px-3 py-1 bg-white shadow-sm" onclick="quickFill('customer')">
                                👤 Customer
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-danger rounded-pill px-3 py-1 bg-white shadow-sm" onclick="quickFill('restaurant')">
                                🍳 Restaurant
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-success rounded-pill px-3 py-1 bg-white shadow-sm" onclick="quickFill('rider')">
                                🛵 Rider Fleet
                            </button>
                            <button type="button" class="btn btn-sm btn-outline-primary rounded-pill px-3 py-1 bg-white shadow-sm" onclick="quickFill('admin')">
                                🛡️ Super Admin
                            </button>
                        </div>
                    </div>

                    <!-- Login Form -->
                    @using (Html.BeginForm("Login", "Account", new { returnUrl = ViewBag.ReturnUrl }, FormMethod.Post, new { id = "roleLoginForm" }))
                    {
                        @Html.AntiForgeryToken()

                        <!-- Hidden Field for Selected Role -->
                        @Html.HiddenFor(m => m.LoginRole, new { id = "hiddenLoginRole" })

                        @Html.ValidationSummary(true, "", new { @class = "alert alert-danger border-0 rounded-3 mb-3 small" })

                        <!-- Email / Username Field -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">
                                <i class="fa-solid fa-envelope text-muted me-1"></i> Email or Username
                            </label>
                            @Html.TextBoxFor(m => m.EmailOrUsername, new { 
                                @class = "form-control form-control-lg rounded-3 fs-6", 
                                placeholder = "e.g. customer@foodexpress.com",
                                id = "emailInput",
                                required = "required"
                            })
                            @Html.ValidationMessageFor(m => m.EmailOrUsername, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Password Field -->
                        <div class="mb-3">
                            <label class="form-label small fw-semibold text-dark">
                                <i class="fa-solid fa-lock text-muted me-1"></i> Password
                            </label>
                            <div class="input-group">
                                @Html.PasswordFor(m => m.Password, new { 
                                    @class = "form-control form-control-lg rounded-start-3 fs-6", 
                                    placeholder = "Enter your account password",
                                    id = "passwordInput",
                                    required = "required"
                                })
                                <button class="btn btn-outline-secondary rounded-end-3" type="button" onclick="togglePasswordVisibility()">
                                    <i class="fa-solid fa-eye" id="togglePasswordIcon"></i>
                                </button>
                            </div>
                            @Html.ValidationMessageFor(m => m.Password, "", new { @class = "text-danger small" })
                        </div>

                        <!-- Remember Me -->
                        <div class="d-flex justify-content-between align-items-center mb-4">
                            <div class="form-check">
                                @Html.CheckBoxFor(m => m.RememberMe, new { @class = "form-check-input", id = "rememberMeCheck" })
                                <label class="form-check-label small text-muted" for="rememberMeCheck">Keep me signed in</label>
                            </div>
                            <span class="small text-muted" id="roleBadgeHelp">Role: <strong class="text-danger" id="currentRoleText">Customer</strong></span>
                        </div>

                        <!-- Submit Button (Dynamically Labeled) -->
                        <button type="submit" class="btn btn-danger btn-lg w-100 rounded-pill fw-bold shadow-sm py-3" id="submitLoginBtn" style="background-color: #ff4757; border-color: #ff4757;">
                            <i class="fa-solid fa-arrow-right-to-bracket me-2"></i> <span id="submitBtnText">Sign In as Customer</span>
                        </button>
                    }

                </div>

                <div class="card-footer p-3 text-center bg-light border-top text-muted small">
                    Don't have an account yet? 
                    <a href="@Url.Action("Register", "Account")" class="text-danger fw-bold text-decoration-none">Create a FoodExpress Account</a>
                </div>
            </div>

        </div>
    </div>
</div>

@section Scripts{
    @Scripts.Render("~/bundles/jqueryval")

    <script>
        // Preset Credentials for Easy Demo & Evaluation
        const demoCreds = {
            customer: { email: 'customer@foodexpress.com', pass: 'User@123', role: 'Customer' },
            restaurant: { email: 'restaurant@foodexpress.com', pass: 'Store@123', role: 'Restaurant' },
            rider: { email: 'rider@foodexpress.com', pass: 'Rider@123', role: 'DeliveryAgent' },
            admin: { email: 'admin@foodexpress.com', pass: 'Admin@123', role: 'Admin' }
        };

        function selectRole(role) {
            $("#hiddenLoginRole").val(role);
            $("#currentRoleText").text(role);
            $("#submitBtnText").text("Sign In as " + role);

            // Highlight button
            $(".role-pill-btn").removeClass("btn-danger fw-bold shadow-sm").addClass("btn-light");
            event.currentTarget ? $(event.currentTarget).removeClass("btn-light").addClass("btn-danger fw-bold shadow-sm") : null;
        }

        function quickFill(type) {
            const data = demoCreds[type];
            if (!data) return;

            $("#emailInput").val(data.email);
            $("#passwordInput").val(data.pass);
            $("#hiddenLoginRole").val(data.role);
            $("#currentRoleText").text(data.role);
            $("#submitBtnText").text("Sign In as " + data.role);

            // Update UI buttons
            $(".role-pill-btn").each(function () {
                const txt = $(this).find("span").text().trim();
                if ((type === 'rider' && txt === 'Rider') || txt.toLowerCase().includes(type)) {
                    $(".role-pill-btn").removeClass("btn-danger fw-bold shadow-sm").addClass("btn-light");
                    $(this).removeClass("btn-light").addClass("btn-danger fw-bold shadow-sm");
                }
            });
        }

        function togglePasswordVisibility() {
            const pass = document.getElementById("passwordInput");
            const icon = document.getElementById("togglePasswordIcon");
            if (pass.type === "password") {
                pass.type = "text";
                icon.classList.remove("fa-eye");
                icon.classList.add("fa-eye-slash");
            } else {
                pass.type = "password";
                icon.classList.remove("fa-eye-slash");
                icon.classList.add("fa-eye");
            }
        }
    </script>
}
